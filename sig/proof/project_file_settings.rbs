module Proof
  # Reads the settings that a `defaults` or `task` node gives.
  #
  # Both nodes take the properties `cpus`, `memory`, and `timeout`, and the
  # children `os`, `label`, `artifact`, and `cache`. The domain owns what makes
  # each value valid, and `Proof::TaskSettings` owns how they combine. Writing
  # those rules a second time in the reader would let the two drift.
  #
  # This class builds each property's and each child's value with the domain's
  # classes, so a size, a duration, a count of CPUs, and a label have one rule
  # each, and returns the `Proof::TaskSettings` that the domain builds from
  # them. A value the domain refuses is a refusal at the line of the node that
  # gave it. It checks no name: `Proof::KdlFormCheck` has refused a property or
  # child the page doesn't list before.
  #
  # Use it from `Proof::ProjectFileReader` and `Proof::TaskReader`.
  class ProjectFileSettings
    # Prepares to read with `refusal`.
    #
    # - `refusal`: `Proof::ProjectFileRefusal`.
    def initialize: (refusal: ProjectFileRefusal) -> void

    # The settings of `node`. A property or child the node lacks gives no
    # setting, as `nil`.
    #
    # - `node`: `Proof::KdlNode`, a `defaults` or `task` node that
    #   `Proof::KdlFormCheck` has checked.
    #
    # ```ruby
    # path = ".config/proof.kdl"
    # node = Proof::KdlParser.parse("defaults cpus=4 {\n  os linux\n}\n", path:).first
    # settings = Proof::ProjectFileSettings.new(refusal: Proof::ProjectFileRefusal.new(path:)).read(node)
    # [settings.cpus, settings.os.map(&:to_s)] # => [4, ["linux"]]
    # ```
    #
    # A value the domain refuses is refused at the line of its node:
    #
    # ```ruby
    # path = ".config/proof.kdl"
    # node = Proof::KdlParser.parse("task test {\n  label \"nvidia gpu\"\n}\n", path:).first
    # begin
    #   Proof::ProjectFileSettings.new(refusal: Proof::ProjectFileRefusal.new(path:)).read(node)
    # rescue Proof::ProjectFileError => e
    #   e.line # => 2
    # end
    # ```
    def read: (KdlNode node) -> TaskSettings

    private

    def properties_of: (KdlNode node) -> Hash[Symbol, Object]

    def children_of: (Array[KdlNode] children) -> Hash[Symbol, Object]

    def pair: (String name, KdlNode giver) -> [Symbol, Object]

    # The member of the settings that each property and child gives, by its
    # name.
    MEMBERS: Hash[Symbol, Symbol]

    # The builder of each value, by the name of the property or child that
    # gives it. A property's builder takes the node that has the property, and
    # a child's takes the child.
    BUILDERS: Hash[Symbol, ^(KdlNode) -> Object]

    @refusal: ProjectFileRefusal
  end
end
