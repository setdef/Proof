module Proof
  # Builds the values of the nodes of the pool file that give their settings as
  # properties: `server`, `retention`, and `limits`.
  #
  # `server port=7443`, `retention runs="90d"`, and `limits output="1GB"` give
  # their settings as properties. The domain owns what makes each value valid:
  # a port, a duration in days, and a size. Writing those rules a second time in
  # the reader would let the two drift.
  #
  # This class builds each property's value with the domain's classes, so a
  # port, a duration, and a size have one rule each, and a value the domain
  # refuses is a refusal at the line of the node that gave it. It builds the
  # `Proof::Port`, the `Proof::Retention`, and the `Proof::Limits` of the file, and
  # leaves out what the file doesn't give, so the defaults stand.
  #
  # Use it from `Proof::PoolFileReader`.
  class PoolFileProperties
    # The builder of a `retention` property's value, from the property's name.
    DAYS: ^(String) -> Proc

    # The builder of a `limits` property's value, from the property's name.
    SIZE: ^(String) -> Proc

    # The member that each property sets and the builder of its value, by the
    # node's name and the property's name. A builder takes the node that has
    # the property.
    TABLES: Hash[Symbol, Hash[Symbol, KdlMembers::entry]]

    # What each node sets in the file, from the values of its properties.
    PARTS: Hash[Symbol, ^(Hash[Symbol, Object]) -> Hash[Symbol, Object]]

    # Prepares to build with `refusal`.
    #
    # - `refusal`: `Proof::PoolFileRefusal`.
    def initialize: (refusal: PoolFileRefusal) -> void

    # What the nodes of `by_name` that give properties set in the file: the
    # port, the retention, and the limits, each only when the file has its node.
    #
    # - `by_name`: Hash from a node's name as a symbol to the nodes of that name,
    #   which `Proof::KdlFormCheck` has checked.
    #
    # ```ruby
    # path = "pool.kdl"
    # nodes = Proof::KdlParser.parse("server port=8443\n", path:, error: Proof::PoolFileError)
    # by_name = nodes.group_by { |node| node.name.to_sym }
    # Proof::PoolFileProperties.new(refusal: Proof::PoolFileRefusal.new(path:)).read(by_name) # => {port: Proof::Port.new(number: 8443)}
    # ```
    def read: (Hash[Symbol, Array[KdlNode]] by_name) -> Hash[Symbol, Object]

    private

    def part_of: (Symbol name, ^(Hash[Symbol, Object]) -> Hash[Symbol, Object] part, KdlNode? node) -> Hash[Symbol, Object]?

    @members: Hash[Symbol, KdlMembers]
  end
end
