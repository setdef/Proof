module Proof
  # A project that lives in a Git repository on this computer, found from a
  # folder inside it.
  #
  # Proof sends code as Git commits, so a run needs a Git repository to start
  # from. A person, or an agent whose shell has drifted into another
  # project's folder, runs `proof` from wherever they are. Guessing the
  # project from a name or a parent folder could send the wrong code.
  #
  # This class asks Git for the repository's root, and raises
  # `Proof::NotInRepositoryError` when the folder has none. It runs Git
  # through `Proof::Git`, so a `GIT_DIR` that a hook set can't point it at
  # another repository. It implements the domain's `_Project` port.
  #
  # Use it to find the project of the current folder, or of the folder you give
  # with `-C`.
  #
  # ## Examples
  #
  # ```ruby
  # require "tmpdir"
  # Dir.mktmpdir do |folder|
  #   system("git", "init", "--quiet", folder)
  #   Proof::GitProject.find(folder).root == File.realpath(folder)
  # end
  # # => true
  # ```
  #
  # A folder outside any repository raises:
  #
  # ```ruby
  # # Wrong: raises Proof::NotInRepositoryError
  # Dir.mktmpdir { |folder| Proof::GitProject.find(folder) }
  # ```
  class GitProject < Data
    # Matches the line of `git config --list` that marks a partial clone.
    PARTIAL_SETTING: Regexp

    # The project's root, as an absolute path with symbolic links resolved.
    attr_reader root: String

    # The git program's name or path.
    attr_reader program: String

    # Builds the project of the repository at `root`. Use `find` to look for
    # one from a folder.
    #
    # - `root`: String, the project's root.
    # - `program`: String, the git program's name or path.
    def self.new: (root: String, program: String) -> instance
                | (String root, String program) -> instance

    # Finds the project that contains `folder`. Raises
    # `Proof::NotInRepositoryError` when `folder` doesn't exist, isn't inside a
    # Git repository, or is a bare repository, which has no working tree.
    #
    # - `folder`: String, a folder inside the project.
    # - `program`: String, the git program's name or path.
    def self.find: (String folder, ?program: String) -> GitProject

    # The full ID of the commit that `revision` identifies, such as `HEAD`, a
    # branch, a tag, or a commit's first digits. An annotated tag gives the
    # commit it marks. Raises `Proof::PartialCloneError` when the project is a
    # partial clone, and `Proof::UnknownRevisionError` when `revision` isn't a
    # commit the project has, which includes every revision of a project with no
    # commit yet. Raises `Proof::GitFailedError` when Git fails in some other way,
    # such as when it can't read the project's configuration. Text that starts
    # with `-` is a revision to look up, never an option.
    #
    # - `revision`: String, as a person typed it.
    #
    # ```ruby
    # require "tmpdir"
    # Dir.mktmpdir do |folder|
    #   system("git", "init", "--quiet", folder)
    #   system("git", "-C", folder, "-c", "user.name=Ann", "-c", "user.email=ann@example.com", "commit", "--quiet", "--allow-empty", "-m", "First")
    #   Proof::GitProject.find(folder).commit_id("HEAD").length
    # end
    # # => 40
    # ```
    def commit_id: (String revision) -> String

    # The full ID of a new commit that holds the project's working tree as it
    # is. It has the changes not yet committed, the untracked files that
    # `.gitignore` doesn't match, and every tracked file, including one that
    # `.gitignore` matches. Its one parent is `HEAD`, and it has no parent when
    # the project has no commit yet. Making it leaves the clone's index,
    # `HEAD`, and branches exactly as they were: Git builds the tree in a
    # temporary index file that starts as a copy of the clone's index file, or
    # empty when the clone has none.
    #
    # Raises `Proof::PartialCloneError` when the project is a partial clone, and
    # `Proof::GitFailedError` when Git fails.
    #
    # ```ruby
    # require "tmpdir"
    # Dir.mktmpdir do |folder|
    #   git = ["git", "-C", folder, "-c", "user.name=Ann", "-c", "user.email=ann@example.com"]
    #   system(*git, "init", "--quiet")
    #   system(*git, "commit", "--quiet", "--allow-empty", "-m", "First")
    #   File.write(File.join(folder, "new.txt"), "new")
    #   id = Proof::GitProject.find(folder).working_tree_commit_id
    #   IO.popen([*git, "ls-tree", "--name-only", id], &:read)
    # end
    # # => "new.txt\n"
    # ```
    #
    # A project with no commit yet gets a commit with no parent:
    #
    # ```ruby
    # require "tmpdir"
    # Dir.mktmpdir do |folder|
    #   system("git", "init", "--quiet", folder)
    #   File.write(File.join(folder, "new.txt"), "new")
    #   id = Proof::GitProject.find(folder).working_tree_commit_id
    #   IO.popen(["git", "-C", folder, "rev-list", "--parents", "-n1", id], &:read).split.length
    # end
    # # => 1
    # ```
    def working_tree_commit_id: () -> String

    # The text of the file at `path` in the commit that `id` identifies, which
    # is how the project file is read from what Proof sends: the commit of
    # `--commit`, or the working-tree commit. The text is what the commit
    # holds, byte for byte, and never what is on disk, so a change on disk that
    # the commit lacks isn't in it. It is `nil` when the commit has no file at
    # `path`, and also when `path` is a folder or a submodule. `path` is
    # written as Git writes it, from the project's root, with no `./` before it
    # and no slash after it: `".config/"`, `"."`, and `"./.config/proof.kdl"`
    # give `nil`. A file that is empty gives `""`. Raises `Proof::SymbolicLinkError`
    # when `path` is a symbolic link, because Proof reads only a regular file.
    # Raises `Proof::UnknownRevisionError` when `id` isn't a commit the project
    # has, `Proof::PartialCloneError` when the project is a partial clone, and
    # `Proof::GitFailedError` when Git fails in some other way. A `path` that
    # starts with `-` is a path to look up, never an option.
    #
    # - `id`: String, a full commit ID, such as `commit_id` or
    #   `working_tree_commit_id` gives.
    # - `path`: String, the file's path from the project's root.
    #
    # ```ruby
    # require "tmpdir"
    # Dir.mktmpdir do |folder|
    #   git = ["git", "-C", folder, "-c", "user.name=Ann", "-c", "user.email=ann@example.com"]
    #   system(*git, "init", "--quiet")
    #   File.write(File.join(folder, "proof.kdl"), "task test\n")
    #   system(*git, "add", "proof.kdl")
    #   system(*git, "commit", "--quiet", "-m", "First")
    #   File.write(File.join(folder, "proof.kdl"), "task other\n")
    #   project = Proof::GitProject.find(folder)
    #   head = project.commit_id("HEAD")
    #   [project.file_at(head, "proof.kdl"), project.file_at(head, "missing.kdl")]
    # end
    # # => ["task test\n", nil]
    # ```
    def file_at: (String id, String path) -> String?

    private

    def resolve: (String revision) -> String

    def git: () -> Git

    def refuse_a_partial_clone: () -> void
  end
end
