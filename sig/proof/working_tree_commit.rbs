module Proof
  # The commit of a project's working tree, made without touching the clone.
  #
  # A run can check the working tree as it is, with the changes not yet
  # committed. Git has no command for that. Staging the changes with `git add`
  # changes the clone's index, and a commit changes its branch, so Proof
  # would leave behind what the person never asked for.
  #
  # This class builds the commit in a temporary index file, so the clone's
  # index, branch, and `HEAD` stay exactly as they were, and so does every other
  # file in its `.git`, apart from the new objects. The temporary index
  # starts as a copy of the clone's index, never empty: `git add --all` leaves
  # out a file that `.gitignore` matches, and an empty index doesn't know that
  # such a file is tracked, so it would drop it. The copy also keeps a file that
  # you staged with `git add -f`, as `git commit` would, and lets `git add
  # --all` skip the files that haven't changed. Every command that writes the
  # temporary index runs with `core.splitIndex=false` and `core.fsmonitor=false`,
  # so it never refers to a shared index file in the clone's `.git`, never adds
  # one, and never starts a file-system monitor there. A submodule
  # goes in at the commit its checkout is at, as `git add --all` records it,
  # including a commit that the project hasn't recorded yet. Changes to files
  # inside the submodule are not sent. The commit's one parent is `HEAD`, and a
  # project with no commit yet has no `HEAD`, so its commit has no parent, and
  # it has no index file to copy, so its index starts empty. Its author and
  # committer are `Proof <proof@proof.invalid>`, so a computer with no Git
  # identity can make it, and its configuration can't sign it.
  #
  # `Proof::GitProject#working_tree_commit_id` uses it. Make one of this class
  # only through that method, which checks that the clone is whole first.
  #
  # ## Examples
  #
  # ```ruby
  # require "tmpdir"
  # Dir.mktmpdir do |folder|
  #   git = ["git", "-C", folder, "-c", "user.name=Ann", "-c", "user.email=ann@example.com"]
  #   system(*git, "init", "--quiet")
  #   system(*git, "commit", "--quiet", "--allow-empty", "-m", "First")
  #   File.write(File.join(folder, "new.txt"), "new")
  #   id = Proof::WorkingTreeCommit.new(git: Proof::Git.new(folder:)).id
  #   IO.popen([*git, "ls-tree", "--name-only", id], &:read)
  # end
  # # => "new.txt\n"
  # ```
  class WorkingTreeCommit
    # The name and address of the commit's author and committer.
    IDENTITY: Hash[Symbol, String]

    # The environment variables that give Git the settings that every command
    # writing the temporary index runs with.
    CONFIG: Hash[Symbol, String]

    # Prepares to make a commit of the working tree of the project that `git`
    # runs in, on top of its `HEAD`.
    #
    # - `git`: Proof::Git, running in the project's root.
    def initialize: (git: Git) -> void

    # Makes the commit and returns its full ID.
    def id: () -> String

    private

    @git: Git

    def commit_tree_of: (String index) -> String

    def copy_the_clones_index: (String index) -> void

    def commit: (String tree) -> String

    def head_id: () -> String?
  end
end
