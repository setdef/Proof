module Proof
  # Checks the nodes of a pool file as a list: which nodes the file has, and
  # which it has twice.
  #
  # The page lists `server`, `retention`, `limits`, `defaults`, and `host`. KDL
  # accepts any other node, and a second `server` would override the first, so
  # the person would believe the server listens where they wrote.
  #
  # This class refuses a node the page doesn't list, and a second node of a name
  # that the file may have only once, at the second. It checks each node's shape
  # with `Proof::PoolFileShape` in the order the file has them, so the first
  # mistake in the file is the one refused.
  #
  # Use it from `Proof::PoolFileReader`.
  class PoolFileNodes
    # The names of the nodes of the file.
    TOP: Array[Symbol]

    # Prepares to check `nodes`.
    #
    # - `nodes`: Array of `Proof::KdlNode`, the file's nodes.
    # - `refusal`: `Proof::PoolFileRefusal`.
    def initialize: (nodes: Array[KdlNode], refusal: PoolFileRefusal) -> void

    # Checks every node of the file, in order, and raises
    # `Proof::PoolFileError` at the line of the first thing wrong.
    #
    # ```ruby
    # path = "pool.kdl"
    # nodes = Proof::KdlParser.parse("server port=7443\n", path:, error: Proof::PoolFileError)
    # Proof::PoolFileNodes.new(nodes:, refusal: Proof::PoolFileRefusal.new(path:)).check # => nodes
    # ```
    def check: () -> void

    private

    def check_node: (KdlNode node, Array[KdlNode] earlier) -> void

    def refuse_unknown: (KdlNode node) -> void

    @nodes: Array[KdlNode]
    @refusal: PoolFileRefusal
    @shape: PoolFileShape
  end
end
