module Proof
  # Checks the shape of a node of the pool file: its arguments, its properties,
  # and its children.
  #
  # KDL accepts any node with any arguments, properties, and children. A
  # misspelled property would be dropped, and a server node that took a port as an
  # argument would leave the port at its default, so the person would believe the
  # server listens where they wrote.
  #
  # This class holds what each node of the pool file takes, and refuses what the
  # page doesn't list. It checks no value. `Proof::PoolFileProperties` builds
  # those.
  #
  # Use it from `Proof::PoolFileReader`.
  class PoolFileShape
    # For each node, its usage as the messages quote it.
    USAGES: Hash[Symbol, String]

    # For each node, the names of its properties.
    PROPERTIES: Hash[Symbol, Array[Symbol]]

    # Words a list of names for a message: two names take "and", and three or
    # more take a serial comma.
    LISTED: ^(Array[Symbol] names) -> String

    # Prepares to check with `refusal`.
    #
    # - `refusal`: `Proof::PoolFileRefusal`.
    def initialize: (refusal: PoolFileRefusal) -> void

    # Refuses `node` unless it has no arguments, only the properties its form
    # lists, and no children. Raises `Proof::PoolFileError` at the line of the
    # first thing wrong.
    #
    # - `node`: `Proof::KdlNode`, a `server`, `retention`, or `limits` node.
    #
    # ```ruby
    # path = "pool.kdl"
    # node = Proof::KdlParser.parse("server port=7443\n", path:, error: Proof::PoolFileError).first
    # Proof::PoolFileShape.new(refusal: Proof::PoolFileRefusal.new(path:)).check(node) # => node.children
    # ```
    def check: (KdlNode node) -> void

    private

    def refuse_arguments: (KdlNode node, String usage) -> void

    def refuse_children: (KdlNode node) -> void

    def refuse_stray_property: (KdlNode node, Array[Symbol] known) -> void

    @refusal: PoolFileRefusal
  end
end
