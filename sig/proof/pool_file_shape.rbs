module Proof
  # Checks the shape of a node of the pool file: its arguments, its properties,
  # and its children.
  #
  # KDL accepts any node with any arguments, properties, and children. A
  # misspelled property would be dropped, a server node that took a port as an
  # argument would leave the port at its default, and a bare `withhold` would
  # withhold nothing, so the person would believe the file says what they
  # wrote.
  #
  # This class checks a node against its `Proof::PoolFileForm`, and each of its
  # children against theirs, and refuses what the page doesn't list: a child
  # that isn't listed, a child given twice that may not be, a wrong number of
  # arguments, a property that isn't listed or is missing, and a child that is
  # missing. It checks no value. `Proof::PoolFileProperties` and
  # `Proof::PoolFileSettings` build those.
  #
  # Use it from `Proof::PoolFileNodes`.
  class PoolFileShape
    # Prepares to check with `refusal`.
    #
    # - `refusal`: `Proof::PoolFileRefusal`.
    def initialize: (refusal: PoolFileRefusal) -> void

    # Checks `node` against its form, and its children against theirs.
    #
    # - `node`: `Proof::KdlNode`, a node the page lists.
    #
    # ```ruby
    # path = "pool.kdl"
    # node = Proof::KdlParser.parse("host nuc {\n  runner nuc-linux\n}\n", path:, error: Proof::PoolFileError).first
    # Proof::PoolFileShape.new(refusal: Proof::PoolFileRefusal.new(path:)).check(node) # => nil
    # ```
    def check: (KdlNode node) -> void

    private

    def refuse_properties: (KdlNode node, PoolFileForm form) -> void

    def refuse_children: (KdlNode node, PoolFileForm form) -> void

    def refuse_child: (KdlNode parent, KdlNode child, KdlNode? first) -> void

    def refuse_stray: (KdlNode node, String property) -> void

    def refuse_unknown: (KdlNode parent, KdlNode child) -> void

    @refusal: PoolFileRefusal
  end
end
