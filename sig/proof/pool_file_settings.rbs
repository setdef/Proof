module Proof
  # Builds the settings that the children of a `defaults` or `host` node give.
  #
  # Both nodes take `budget`, `keep-free`, `share`, `active-for`, and
  # `withhold`. The domain owns what makes each value valid: a size, a share, a
  # duration, and a set of labels. Writing those rules a second time in the
  # reader would let the two drift.
  #
  # This class builds each child's value with the domain's classes, so a size, a
  # duration, and a label have one rule each, and gives the
  # `Proof::HostSettings` that the domain builds from them, or the
  # `Proof::HostEntry` of a host. A child the node lacks gives no setting. A value
  # the domain refuses is a refusal at the line of the child that gave it.
  #
  # Use it from `Proof::PoolFileHosts`.
  class PoolFileSettings
    # The member of `Proof::HostSettings` that each child sets.
    MEMBERS: Hash[Symbol, Symbol]

    # The builder of each child's value.
    BUILDERS: Hash[Symbol, ^(KdlNode) -> Object]

    # Prepares to build the settings of `node`.
    #
    # - `node`: `Proof::KdlNode`, a `defaults` or `host` node.
    # - `refusal`: `Proof::PoolFileRefusal`.
    def initialize: (node: KdlNode, refusal: PoolFileRefusal) -> void

    # The settings of the node. A child the node lacks gives no setting, as
    # `nil`.
    #
    # ```ruby
    # path = "pool.kdl"
    # node = Proof::KdlParser.parse("defaults {\n  budget \"100GB\"\n}\n", path:, error: Proof::PoolFileError).first
    # refusal = Proof::PoolFileRefusal.new(path:)
    # Proof::PoolFileSettings.new(node:, refusal:).settings.budget.megabytes # => 102_400
    # ```
    def settings: () -> HostSettings

    # The entry of a `host` node: its name, its runners, and its settings.
    # Raises `Proof::InvalidHostEntryError` for what the domain refuses.
    #
    # ```ruby
    # path = "pool.kdl"
    # text = "host nuc {\n  runner nuc-linux\n}\n"
    # node = Proof::KdlParser.parse(text, path:, error: Proof::PoolFileError).first
    # Proof::PoolFileSettings.new(node:, refusal: Proof::PoolFileRefusal.new(path:)).entry.runners # => ["nuc-linux"]
    # ```
    def entry: () -> HostEntry

    private

    def pair: (KdlNode child) -> [Symbol, Object]?

    @node: KdlNode
    @refusal: PoolFileRefusal
  end
end
