module Proof
  # Checks the entries of a pool file against each other: two hosts with one
  # name, a runner on two hosts, and two repositories with one name.
  #
  # The domain refuses all three, in `Proof::PoolFile`, but a mistake in what
  # the file says needs a line, and the domain has none. A second host with a
  # host's name would show its runs under one name in `proof status`, and a
  # runner on two hosts would count that runner's CPUs and memory twice, since a
  # runner is one operating system on one host.
  #
  # This class refuses each at the line of the second entry, or of the runner
  # that repeats, and names the earlier entry. It compares names as written, so
  # `nuc` and `NUC` are two hosts, and a host and a repository may share a name.
  #
  # Use it from `Proof::PoolFileReader`.
  class PoolFileEntries
    # Prepares to check the entries in `by_name`.
    #
    # - `by_name`: Hash from a node's name as a symbol to the nodes of that name,
    #   which `Proof::PoolFileShape` has checked.
    # - `refusal`: `Proof::PoolFileRefusal`.
    def initialize: (by_name: Hash[Symbol, Array[KdlNode]], refusal: PoolFileRefusal) -> void

    # Refuses the first name that repeats among the hosts, then the first runner
    # on two hosts, then the first name that repeats among the repositories, in
    # the order the file has them, at the second entry or runner, and names the
    # first.
    #
    # ```ruby
    # path = "pool.kdl"
    # text = "host a {\n  runner r\n}\nhost a {\n  runner s\n}\n"
    # nodes = Proof::KdlParser.parse(text, path:, error: Proof::PoolFileError)
    # by_name = nodes.group_by { |node| node.name.to_sym }
    # begin
    #   Proof::PoolFileEntries.new(by_name:, refusal: Proof::PoolFileRefusal.new(path:)).check
    # rescue Proof::PoolFileError => e
    #   e.line # => 4
    # end
    # ```
    def check: () -> void

    private

    def entries: (Symbol kind) -> Array[KdlNode]

    def refuse_repeats: (Symbol kind) -> void

    def refuse_repeat: (KdlNode entry, Symbol kind, Integer index) -> void

    def refuse_shared_runners: () -> void

    def refuse_shared_in: (KdlNode host) -> void

    def refuse_listed: (KdlNode child, kdl_value runner, KdlNode host) -> void

    @by_name: Hash[Symbol, Array[KdlNode]]
    @refusal: PoolFileRefusal
  end
end
