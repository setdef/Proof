module Proof
  # Raises `Proof::PoolFileError` for each way the shape of a pool file can be
  # wrong, with the message for it.
  #
  # A refusal names a file and a line, and the reader would repeat both at every
  # place it refuses something. The wording is the person's whole help in fixing
  # the file, so it sits in one place, where it can be read as a list.
  #
  # This class holds the file's path, and has one method for each refusal: a
  # node the page doesn't list, a node given twice, a node with arguments,
  # properties, or children it doesn't take, a child with the wrong arguments, a
  # blank name, and a part a node needs and lacks. Each method raises, and never
  # returns. It also turns what the domain refuses into the same error, at the
  # line of the node it was building.
  #
  # Use it from the classes that read a pool file's nodes.
  class PoolFileRefusal < FileRefusal
    # The messages, by name, for `format` to fill in.
    MESSAGES: Hash[Symbol, String]

    # What a node takes, as a message words it, by the numbers of arguments.
    TAKES: Hash[Range[Integer?], String]

    # What a message says of an earlier entry: its name and its line.
    EARLIER: ^(KdlNode node) -> Hash[Symbol, kdl_value]

    # Words what a node has, for a message: none, two with "and", or three or
    # more with a serial comma, after `what`, such as "properties".
    KNOWN: ^(Array[Symbol] names, String what) -> String

    # Prepares to refuse as the file at `path`.
    #
    # - `path`: String, the file's path.
    def initialize: (path: String) -> void

    # Refuses a top-level node that the page doesn't list.
    def unknown_node: (KdlNode node) -> bot

    # Refuses a second node that the file may have only once. `first` is the node
    # before it.
    def repeated_node: (KdlNode node, KdlNode first) -> bot

    # Refuses a node with a number of arguments its form doesn't take, and says
    # what it takes and how to write it. `count` is how many it has.
    def node_arguments: (KdlNode node, PoolFileForm form, Integer count) -> bot

    # Refuses a property that the node's form doesn't list, and lists the ones
    # it has. When the property is the name of a child, it says to write it as
    # a child.
    def unknown_property: (KdlNode node, String property, PoolFileForm form) -> bot

    # Refuses a child that the parent's form doesn't list, and lists the ones it
    # has.
    def unknown_child: (KdlNode parent, KdlNode child, PoolFileForm form) -> bot

    # Refuses a child given a second time. `first` is the one before it.
    def repeated_child: (KdlNode child, KdlNode first) -> bot

    # Refuses a second entry that has the name of an earlier one, such as a
    # second host with a host's name. `first` is the earlier entry.
    def repeated_entry: (KdlNode node, KdlNode first) -> bot

    # Refuses a runner that an earlier host lists. `child` is the `runner` node
    # that lists it again, and `host` is the earlier host.
    def shared_runner: (KdlNode child, kdl_value runner, KdlNode host) -> bot

    # Refuses a node that lacks a property its form needs.
    def missing_property: (KdlNode node, String property) -> bot

    # Refuses a node that lacks a child its form needs.
    def missing_child: (KdlNode node, String child) -> bot

    # Refuses a name that is empty or only spaces. `what` says whose name it is.
    def blank_name: (KdlNode node, String what, kdl_value value) -> bot

    private

    def say_of: (KdlNode node, Symbol key, **kdl_value values) -> bot
  end
end
