module Proof
  module CommandLine
    # What the words of a command line look like: a flag, or several one-letter flags written together.
    module Tokens
      # Whether the word looks like a flag.
      def self.flag?: (String token) -> bool

      # Writes several one-letter flags together as separate flags.
      def self.expand: (String token) -> Array[String]

      # The name of the flag that OptionParser refused, as the person typed it.
      #
      # `flag` is what OptionParser gives for the refused flag. A long flag with a value is named without the value:
      # `--os=linux` is `--os`. `-q=1` expands to `-q`, `-=`, and `-1`, so OptionParser refuses `-=`, and the name is
      # the word among `tokens` that expanded to it, `-q=1`.
      def self.named: (String flag, Array[String] tokens) -> String

      # The name of the flag in a word, without a value: `--os=linux` is `--os`.
      def self.flag_name: (String token) -> String

      # Whether `token` is a long flag among `switches` written with a value, such as `--quiet=1`.
      def self.valued?: (String token, Array[String] switches) -> bool

      # The name to give for a word that isn't a flag among `switches`, as the person typed it.
      #
      # The flag's name, without a value, unless the word is one or several short flags among `switches` written
      # with `=`, such as `-q=1`, or begins with `-=`, such as `-=1`, which is named whole.
      def self.typed: (String token, Array[String] switches) -> String

      # Whether `token` is one of `switches`, or several one-letter flags written together that are each among them.
      def self.known?: (String token, Array[String] switches) -> bool

      # Whether `token` is several one-letter flags written together, such as `-qd`, each among `switches`.
      def self.cluster?: (String token, Array[String] switches) -> bool
    end
  end
end
