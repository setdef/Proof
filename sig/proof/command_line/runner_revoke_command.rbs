module Proof
  module CommandLine
    # What `proof runner revoke` was asked to do.
    #
    # Removing a runner from the pool needs its name, and asks first unless it is forced.
    #
    # This class holds each flag and argument of `proof runner revoke` as a value of one
    # type, so the code that runs the command reads a field and never the words.
    #
    # Use it as the result of parsing `proof runner revoke`.
    #
    # ## Examples
    #
    # ```ruby
    # command = Proof::CommandLine::RunnerRevokeCommand.new(name: "nuc-linux", force: false)
    # command.name # => "nuc-linux"
    # ```
    class RunnerRevokeCommand < Data
      # The runner's name, as typed.
      attr_reader name: String

      # Whether to revoke without asking first.
      attr_reader force: bool

      def self.new: (name: String, force: bool) -> instance
                  | (String name, bool force) -> instance

      # Builds the value of a `proof runner revoke` command line from what the words and flags gave.
      #
      # - `name`: String, the runner's name, as typed.
      # - `force`: bool, whether to revoke without asking first.
      def initialize: (name: String, force: bool) -> void
    end
  end
end
