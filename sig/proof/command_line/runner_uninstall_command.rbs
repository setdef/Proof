module Proof
  module CommandLine
    # What `proof runner uninstall` was asked to do.
    #
    # Uninstalling the runner deletes its workspaces and caches, so it asks first unless it is forced.
    #
    # This class holds each flag and argument of `proof runner uninstall` as a value of one
    # type, so the code that runs the command reads a field and never the words.
    #
    # Use it as the result of parsing `proof runner uninstall`.
    #
    # ## Examples
    #
    # ```ruby
    # command = Proof::CommandLine::RunnerUninstallCommand.new(force: false)
    # command.force # => false
    # ```
    class RunnerUninstallCommand < Data
      # Whether to uninstall without asking first.
      attr_reader force: bool

      def self.new: (force: bool) -> instance
                  | (bool force) -> instance

      # Builds the value of a `proof runner uninstall` command line from what the words and flags gave.
      #
      # - `force`: bool, whether to uninstall without asking first.
      def initialize: (force: bool) -> void
    end
  end
end
