module Proof
  module CommandLine
    class Spec
      # A status `proof` can exit with, and what it means.
      #
      # Scripts and agents read the exit status, so each status has to mean one
      # thing. The spec lists them, and the help prints that list.
      #
      # This class answers from the spec's JSON: one status and its meaning.
      #
      # Use it to print the exit statuses in the help.
      #
      # ## Examples
      #
      # ```ruby
      # exit_code = Proof::CommandLine::Spec.load.exit_codes.find { |each| each.status == 2 }
      # exit_code&.help&.start_with?("Proof refused the run") # => true
      # ```
      class ExitCode < Data
        # The JSON object of the status, one entry of `exit_codes`.
        attr_reader node: Node

        def self.new: (node: Node) -> instance
                    | (Node node) -> instance

        # Reads an exit status from its JSON object.
        #
        # - `node`: Node, one entry of `exit_codes`.
        def initialize: (Node node) -> void

        # The exit status, such as `75`.
        #
        # ```ruby
        # Proof::CommandLine::Spec.load.exit_codes.last&.status # => 143
        # ```
        def status: () -> Integer

        # What the status means.
        #
        # ```ruby
        # Proof::CommandLine::Spec.load.exit_codes.first&.help # => "The run succeeded, or the command did what it was asked."
        # ```
        def help: () -> String
      end
    end
  end
end
