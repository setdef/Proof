module Proof
  module CommandLine
    class Spec
      # One flag of a command, as the spec describes it.
      #
      # The parser, the spell checker, and the help all ask what a flag is
      # called, whether it takes a value, which values it accepts, and what it
      # needs beside it. Each asking its own copy of the spec would answer
      # differently.
      #
      # This class answers from the spec's JSON, so a flag is the same thing to all three.
      #
      # Use it to list a command's switches and to check a value against the flag's choices.
      #
      # ## Examples
      #
      # ```ruby
      # output = Proof::CommandLine::Spec.load.command(["download"])&.own_flags&.find { |flag| flag.name == "output" }
      # output&.switches # => ["-o", "--output"]
      # output&.value # => "dir"
      # ```
      class Flag < Data
        # The JSON object of the flag, one entry of a command's `flags`.
        attr_reader node: Node

        def self.new: (node: Node) -> instance
                    | (Node node) -> instance

        # Reads a flag from its JSON object.
        #
        # - `node`: Node, one entry of a command's `flags`.
        def initialize: (Node node) -> void

        # The flag's name in the spec, such as `"input-file"`.
        #
        # ```ruby
        # Proof::CommandLine::Spec.load.command(["run"])&.flags&.map(&:name)&.include?("input-file") # => true
        # ```
        def name: () -> String

        # The one-letter names, without the hyphen, such as `["q"]`.
        #
        # ```ruby
        # Proof::CommandLine::Spec.load.root.flags.find { |flag| flag.name == "quiet" }&.short # => ["q"]
        # ```
        def short: () -> Array[String]

        # The long names, without the hyphens, such as `["quiet"]`.
        #
        # ```ruby
        # Proof::CommandLine::Spec.load.root.flags.find { |flag| flag.name == "quiet" }&.long # => ["quiet"]
        # ```
        def long: () -> Array[String]

        # The name of the value the flag takes, or `nil` for a yes-or-no flag.
        #
        # ```ruby
        # Proof::CommandLine::Spec.load.command(["run"])&.flags&.find { |flag| flag.name == "commit" }&.value # => "rev"
        # ```
        def value: () -> String?

        # Whether the flag may repeat, each time adding a value.
        #
        # ```ruby
        # Proof::CommandLine::Spec.load.command(["run"])&.flags&.find { |flag| flag.name == "os" }&.repeatable? # => true
        # ```
        def repeatable?: () -> bool

        # The values the flag accepts, or an empty list when it takes any.
        #
        # ```ruby
        # Proof::CommandLine::Spec.load.command(["run"])&.flags&.find { |flag| flag.name == "commit" }&.choices # => []
        # ```
        def choices: () -> Array[String]

        # Whether a value outside `choices` is a mistake. A flag with no choices
        # answers `true` and has nothing to check.
        #
        # ```ruby
        # Proof::CommandLine::Spec.load.command(["run"])&.flags&.find { |flag| flag.name == "label" }&.strict? # => false
        # ```
        def strict?: () -> bool

        # The switches that must come with this one, such as `["--download"]`.
        #
        # ```ruby
        # Proof::CommandLine::Spec.load.command(["run"])&.flags&.find { |flag| flag.name == "output" }&.requires # => ["--download"]
        # ```
        def requires: () -> Array[String]

        # Whether the flag works on every command.
        #
        # ```ruby
        # Proof::CommandLine::Spec.load.root.flags.all?(&:global?) # => true
        # ```
        def global?: () -> bool

        # The one-line description, or `nil` when the spec has none.
        #
        # ```ruby
        # Proof::CommandLine::Spec.load.root.flags.first&.help&.start_with?("Print no color") # => true
        # ```
        def help: () -> String?

        # Whether the flag takes a value, as `--os linux` does.
        #
        # ```ruby
        # Proof::CommandLine::Spec.load.root.flags.first&.takes_value? # => false
        # ```
        def takes_value?: () -> bool

        # Every way to type the flag: the short names with one hyphen, then the
        # long names with two.
        #
        # ```ruby
        # Proof::CommandLine::Spec.load.root.flags.find { |flag| flag.name == "quiet" }&.switches # => ["-q", "--quiet"]
        # ```
        def switches: () -> Array[String]
      end
    end
  end
end
