module Proof
  module CommandLine
    class Spec
      # A set of flags and arguments of which a command takes exactly one.
      #
      # `proof run` takes a task or `--script`, never both, and never neither.
      # Left to each flag's own check, nothing would see that the pair is
      # missing or doubled.
      #
      # This class names the members of such a set and says whether one is required.
      #
      # Use it to check that a command line gave one member of each group.
      #
      # ## Examples
      #
      # ```ruby
      # group = Proof::CommandLine::Spec.load.command(["run"])&.groups&.first
      # group&.names # => ["task", "--script"]
      # group&.required? # => true
      # ```
      class Group < Data
        # The JSON object of the group, one entry of a command's `groups`.
        attr_reader node: Node

        def self.new: (node: Node) -> instance
                    | (Node node) -> instance

        # Reads a group from its JSON object.
        #
        # - `node`: Node, one entry of a command's `groups`.
        def initialize: (Node node) -> void

        # The members' names: an argument by its name, or a flag by its switch,
        # such as `"task"` and `"--script"`.
        #
        # ```ruby
        # Proof::CommandLine::Spec.load.command(["run"])&.groups&.first&.names # => ["task", "--script"]
        # ```
        def names: () -> Array[String]

        # Whether one member must be given.
        #
        # ```ruby
        # Proof::CommandLine::Spec.load.command(["run"])&.groups&.first&.required? # => true
        # ```
        def required?: () -> bool
      end
    end
  end
end
