module Proof
  module CommandLine
    # The words the lines for mistakes are made of: each ends with the command to run next.
    class Phrases
      @path: Array[String]

      # The names as one list for a sentence: `a`, `a or b`, or `a, b, or c`.
      def self.alternatives: (Array[String] names) -> String

      # The words that offer the nearest names.
      def self.did_you_mean: (Array[String] suggestions) -> String

      # A member of a group as a person reads it.
      def self.member: (String name) -> String

      # Takes the words that name the command.
      def initialize: (Array[String] path) -> void

      # The command as typed, such as `proof run`.
      def command: () -> String

      # `command` or `subcommand`.
      def kind: () -> String

      # What the command belongs to, or an empty string for a command of `proof` itself.
      def home: () -> String

      private

      def usage: () -> String

      def ending: (String lead) -> String
    end
  end
end
