module Proof
  module CommandLine
    # Builds the value of a command, from the class that stands for it and what its flags and arguments gave.
    class Builder
      @spec: Usage::Spec
      @line: Usage::Parsed
      @command: Usage::Command

      CLASSES: Hash[Array[String], singleton(Data)]

      # Takes the spec, and the command line as the spec read it.
      def initialize: (Usage::Spec spec, Usage::Parsed line) -> void

      # The command's value with the global flags.
      def parsed: () -> Parsed

      private

      def global: () -> GlobalFlags

      def value: () -> command

      # The tasks and the script's words of `proof run`, from the words of its arguments before and after the first
      # `--`, or none for another command. A task given with `--script` is a mistake.
      def tasks: () -> Hash[Symbol, Array[TaskWords] | Array[String]]

      # The words of the arguments of `proof run` before the first `--`, and those after it.
      def run_words: () -> [Array[String], Array[String]]
    end
  end
end
