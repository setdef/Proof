module Proof
  module CommandLine
    # Builds the value of a command, from the class that stands for it and what its flags and arguments gave.
    class Builder
      @spec: Spec
      @command: Spec::Command
      @values: Values

      CLASSES: Hash[Array[String], singleton(Data)]

      # Takes the spec, the command, and the values its flags and arguments gave.
      def initialize: (Spec spec, Spec::Command command, Values values) -> void

      # The command's value with the global flags.
      def invocation: () -> Invocation

      private

      def global: () -> GlobalFlags

      def command: () -> command
    end
  end
end
