module Proof
  module CommandLine
    # Builds the value of a command, from the class that stands for it and what its flags and arguments gave.
    class Builder
      @spec: Usage::Spec
      @command: Usage::Command
      @values: Values

      CLASSES: Hash[Array[String], singleton(Data)]

      # Takes the spec, the command, and the values its flags and arguments gave.
      def initialize: (Usage::Spec spec, Usage::Command command, Values values) -> void

      # The command's value with the global flags.
      def parsed: () -> Parsed

      private

      def global: () -> GlobalFlags

      def command: () -> command

      def construct: (singleton(GlobalFlags) klass, Array[Usage::Flag] flags, Array[Usage::Arg] args) -> GlobalFlags
                   | (singleton(Data) klass, Array[Usage::Flag] flags, Array[Usage::Arg] args) -> command
    end
  end
end
