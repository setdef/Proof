module Proof
  module CommandLine
    # What the flags and arguments of one command line gave, by the names the spec gives them.
    class Values
      @flags: Hash[String, true | String | Array[String]]
      @words: Hash[String, Array[String]]
      @help: bool
      @tasks: Array[TaskWords]?

      # Starts with no flags and no words.
      def initialize: () -> void

      # Records a yes-or-no flag as given.
      def switch: (String name) -> void

      # Records the one value of a flag.
      def replace: (String name, String text) -> void

      # Adds a value to a flag that repeats.
      def append: (String name, String text) -> void

      # Records the words of an argument.
      def assign: (String name, Array[String] words) -> void

      # Records the tasks of `proof run`.
      def assign_tasks: (Array[TaskWords] tasks) -> void

      # The members that come from no flag or argument.
      def extras: () -> Hash[Symbol, Array[TaskWords]?]

      # Records that help was asked for.
      def ask_for_help: () -> void

      # Whether help was asked for.
      def help?: () -> bool

      # Whether the flag was given.
      def flag?: (String name) -> bool

      # Whether the flag or argument was given.
      def given?: (String member) -> bool

      # The one value a flag was given, or `nil`.
      def text: (String name) -> String?

      # The first word an argument was given, or `nil`.
      def first: (String name) -> String?

      # The values a flag was given, or the words an argument was given.
      def list: (String name) -> Array[String]
    end
  end
end
