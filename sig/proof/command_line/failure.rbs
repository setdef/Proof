module Proof
  module CommandLine
    # The line for a command line that OptionParser refused.
    class Failure
      @messages: Messages
      @switches: Array[String]

      # Takes the messages of the command, and the flags its command line may carry.
      def initialize: (Messages messages, Array[Spec::Flag] flags) -> void

      # The line for the flag that OptionParser refused.
      #
      # - `error`: OptionParser::ParseError, what OptionParser raised.
      # - `tokens`: Array of String, the words OptionParser read, as the person typed them.
      def message: (OptionParser::ParseError error, Array[String] tokens) -> String
    end
  end
end
