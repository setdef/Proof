module Proof
  module CommandLine
    # Reads the flags of one command from its tokens, with Ruby's OptionParser.
    class Options
      @flags: Array[Spec::Flag]
      @messages: Messages
      @values: Values

      # An OptionParser without the options it adds itself: --version, and the shell completion flags.
      class Strict < OptionParser
        private def add_officious: () -> void
      end

      # Takes the command, and the global flags that work on every command.
      def initialize: (Spec::Command command, Array[Spec::Flag] globals) -> void

      # The values the flags in `tokens` gave, and the words between them.
      def parse: (Array[String] tokens) -> [Values, Array[String]]

      private

      def parser: () -> Strict

      def prepare: (Strict parser) -> void

      def register: (Strict parser, Spec::Flag flag) -> void
    end
  end
end
