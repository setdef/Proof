module Proof
  module CommandLine
    # The tables of the help: the commands, the arguments, the flags, and the exit statuses.
    class Tables
      @command: Usage::Command
      @globals: Array[Usage::Flag]
      @exit_rows: Array[_Row]

      # Takes the command, the global flags, and the rows of exit statuses.
      def initialize: (Usage::Command command, Array[Usage::Flag] globals, Array[_Row] exit_rows) -> void

      # Each table that has rows, as text.
      def sections: () -> Array[String?]

      private

      def listing: () -> String?

      def arguments: () -> String?

      def flags: () -> String?

      def globals: () -> String?

      def exit_codes: () -> String?
    end
  end
end
