module Proof
  module CommandLine
    # Turns the words after `proof` into the value of a command, or a request for help, or raises a Mistake.
    class Parser
      @spec: Spec

      HELP: Array[String]

      # The words before the first `--`, and the words after it.
      def self.split: (Array[String] argv) -> [Array[String], Array[String]]

      # Takes the spec to parse against.
      def initialize: (Spec spec) -> void

      # Parses the words after `proof`.
      def parse: (Array[String] argv) -> (Invocation | HelpRequest)
    end
  end
end
