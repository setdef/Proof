module Proof
  module CommandLine
    # Turns the words after `proof` into the value of a command, or a request for help, or raises a Mistake.
    class Parser
      @spec: Usage::Spec
      @usage: Usage::Parser

      # Takes the spec to parse against.
      def initialize: (Usage::Spec spec) -> void

      # Parses the words after `proof`.
      def parse: (Array[String] argv) -> (Parsed | HelpAsked)
    end
  end
end
