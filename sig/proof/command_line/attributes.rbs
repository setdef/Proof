module Proof
  module CommandLine
    # What a command's members hold, by member name, read from the flags and arguments of its spec.
    class Attributes
      @slots: Array[FlagSlot | ArgSlot]
      @values: Values

      # Takes the flags and arguments whose values the command holds, and the values the command line gave.
      def initialize: (Array[Usage::Flag] flags, Array[Usage::Arg] args, Values values) -> void

      # The command's members by name, each with what the command line gave.
      def to_h: () -> Hash[Symbol, CommandLine::attribute]
    end
  end
end
