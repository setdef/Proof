module Proof
  module CommandLine
    # Where an argument goes in a command's value, and how to read it from what the command line gave.
    class ArgSlot
      @item: Usage::Arg

      # Takes the argument this slot reads.
      def initialize: (Usage::Arg item) -> void

      # The member's name, and what the command line gave it.
      def entry: (Usage::Parsed line) -> [Symbol, CommandLine::attribute]

      private

      def member: () -> Symbol

      def read: (Usage::Parsed line) -> CommandLine::attribute
    end
  end
end
