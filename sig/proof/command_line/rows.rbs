module Proof
  module CommandLine
    # The rows of the help: what each flag, argument, command, and exit status is called, and what it says.
    module Rows
      # A flag as a row of the help: its switches and value, and what it does.
      class FlagRow
        @item: Usage::Flag

        # Takes the thing to show.
        def initialize: (Usage::Flag item) -> void

        # What the row is called.
        def label: () -> String

        # What the row says.
        def text: () -> String
      end

      # An argument as a row of the help.
      class ArgRow
        @item: Usage::Arg

        # Takes the thing to show.
        def initialize: (Usage::Arg item) -> void

        # What the row is called.
        def label: () -> String

        # What the row says.
        def text: () -> String
      end

      # A command as a row of the help: its name and its one line.
      class CommandRow
        @item: Usage::Command

        # Takes the thing to show.
        def initialize: (Usage::Command item) -> void

        # What the row is called.
        def label: () -> String

        # What the row says.
        def text: () -> String
      end

      # An exit status as a row of the help.
      class ExitRow
        @item: Usage::ExitCode

        # Takes the thing to show.
        def initialize: (Usage::ExitCode item) -> void

        # What the row is called.
        def label: () -> String

        # What the row says.
        def text: () -> String
      end
    end
  end
end
