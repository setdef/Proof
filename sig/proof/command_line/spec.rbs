module Proof
  module CommandLine
    # The command-line interface of `proof`, as `proof.usage.kdl` describes it.
    #
    # The command reads its flags, prints its help, and suggests the flag a person meant from one description of the
    # interface. Written as Ruby beside the spec, those facts would drift from it, and a flag added to the spec would
    # reach no one.
    #
    # `usage generate json` writes the spec as JSON, and the repository keeps that file at
    # `lib/proof/command_line/spec.json`. This module reads it with usage-rb, which loads with Ruby's standard library
    # alone, so the command starts without reading KDL.
    #
    # Use it to find a command by the words that name it, and to list the flags, arguments, and examples of each.
    #
    # ## Examples
    #
    # ```ruby
    # spec = Proof::CommandLine::Spec.load
    # spec.bin # => "proof"
    # spec.commands.find(["server", "setup"])&.help # => "Set up this computer as the pool's server"
    # spec.commands.find(["frobnicate"]) # => nil
    # ```
    #
    # Each flag says which switches name it and whether it takes a value:
    #
    # ```ruby
    # flag = Proof::CommandLine::Spec.load.commands.find(["run"])&.own_flags&.find { |each| each.name == "os" }
    # flag&.switches # => ["--os"]
    # flag&.takes_value? # => true
    # flag&.choices&.values # => ["linux", "macos", "windows", "any", "all"]
    # ```
    module Spec
      # The path of the JSON file the spec is read from.
      PATH: String

      # The spec in `PATH`. Raises `Usage::SpecError` when the file holds a spec that usage-rb can't act on in full.
      #
      # ```ruby
      # Proof::CommandLine::Spec.load.commands.root.subcommand_names.first # => "run"
      # ```
      def self.load: () -> Usage::Spec
    end
  end
end
