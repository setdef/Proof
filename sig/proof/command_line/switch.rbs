module Proof
  module CommandLine
    # One flag of a command, as OptionParser registers it, with what to do with the value it is given.
    class Switch
      @flag: Usage::Flag
      @values: Values
      @messages: Messages

      # Takes a flag, the values to add to, and the messages of its command.
      def initialize: (Usage::Flag flag, Values values, Messages messages) -> void

      # The arguments for `OptionParser#on`: each way to type the flag, and a value after the last when it takes one.
      def specs: () -> Array[String]

      # Checks the value the flag was given and adds it.
      def accept: (String value) -> void

      private def check: (String value) -> void
    end
  end
end
