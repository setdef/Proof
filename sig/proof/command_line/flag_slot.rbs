module Proof
  module CommandLine
    # Where a flag goes in a command's value, and how to read it from what the command line gave.
    class FlagSlot
      @item: Spec::Flag

      # Takes the flag this slot reads.
      def initialize: (Spec::Flag item) -> void

      # The member's name, and what the command line gave it.
      def entry: (Values values) -> [Symbol, CommandLine::attribute]

      private

      def member: () -> Symbol

      def read: (Values values) -> CommandLine::attribute
    end
  end
end
