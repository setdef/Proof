module Proof
  module CommandLine
    # What `proof hook uninstall` was asked to do.
    #
    # Removing the pre-push hook takes nothing but the command.
    #
    # This class stands for `proof hook uninstall` itself, so the code that runs the command
    # is chosen by the value's class and never by the words.
    #
    # Use it as the result of parsing `proof hook uninstall`.
    #
    # ## Examples
    #
    # ```ruby
    # Proof::CommandLine::HookUninstallCommand.new == Proof::CommandLine::HookUninstallCommand.new # => true
    # ```
    class HookUninstallCommand < Data
      def self.new: () -> instance

      # Builds the value of a `proof hook uninstall` command line, which has no flags or arguments of its own.
      def initialize: () -> void
    end
  end
end
