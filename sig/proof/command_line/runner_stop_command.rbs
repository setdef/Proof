module Proof
  module CommandLine
    # What `proof runner stop` was asked to do.
    #
    # Stopping the runner cancels its runs, so it asks first unless it is forced.
    #
    # This class holds each flag and argument of `proof runner stop` as a value of one
    # type, so the code that runs the command reads a field and never the words.
    #
    # Use it as the result of parsing `proof runner stop`.
    #
    # ## Examples
    #
    # ```ruby
    # command = Proof::CommandLine::RunnerStopCommand.new(force: false)
    # command.force # => false
    # ```
    class RunnerStopCommand < Data
      # Whether to stop without asking first.
      attr_reader force: bool

      def self.new: (force: bool) -> instance
                  | (bool force) -> instance

      # Builds the value of a `proof runner stop` command line from what the words and flags gave.
      #
      # - `force`: bool, whether to stop without asking first.
      def initialize: (force: bool) -> void
    end
  end
end
