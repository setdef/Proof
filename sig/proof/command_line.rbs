module Proof
  # Turns the words typed after `proof` into a value for each command.
  #
  # The command's interface is `proof.usage.kdl`, and the words a person or an
  # agent types come in as a list of strings. Every use case would have to
  # read flags, spell-check them, and refuse a mistake the same way, and one
  # that read them differently would accept a command line the spec refuses.
  #
  # This module reads the words once. It reads each command's flags from the
  # spec, hands back a typed value for the command, and raises a mistake that
  # says what is wrong. It starts no run, reads no file, and makes no network
  # call.
  module CommandLine
    # Parses the words typed after `proof`, `ARGV` without the program's name,
    # into the value of the command they name, or into a request for help.
    #
    # Global flags work before or after any subcommand. On `proof run`, the
    # flags work anywhere before `--`, the words after `--` go to the task, and
    # `:::` starts the next task. A mistake raises
    # `Proof::CommandLine::Mistake`, and nothing is read or sent.
    #
    # - `argv`: Array of String, the words as the shell gave them.
    #
    # ```ruby
    # invocation = Proof::CommandLine.parse(["-q", "run", "lint", "--", "--fix", ":::", "test"])
    # invocation.global.quiet # => true
    # invocation.command.tasks.map(&:name) # => ["lint", "test"]
    # invocation.command.tasks.first&.words # => ["--fix"]
    # ```
    #
    # A flag after the subcommand, a flag that takes a value, and a command with
    # no flags all parse the same way:
    #
    # ```ruby
    # Proof::CommandLine.parse(["cancel", "m3d8q"]).command.runs # => ["m3d8q"]
    # Proof::CommandLine.parse(["run", "-h"]).path # => ["run"]
    # ```
    def self.parse: (Array[String] argv) -> (Invocation | HelpRequest)

    # The help for the command at `path`, as `proof` prints it to standard
    # output when asked: what the command does, how to use it, its examples,
    # and its flags, arguments, and subcommands, all read from the spec. An
    # empty `path` is `proof` itself, and a path that names no command
    # gives the help of `proof`.
    #
    # - `path`: Array of String, the words that name the command, as `Proof::CommandLine::HelpRequest#path` gives them.
    #
    # ```ruby
    # Proof::CommandLine.help(["watch"]).lines.first # => "proof watch - Stream a run's output until it ends, and exit with its status\n"
    # Proof::CommandLine.help(["server"]).include?("Usage: proof server [FLAGS] <SUBCOMMAND>") # => true
    # ```
    def self.help: (Array[String] path) -> String

    # What a flag or an argument gave a command: whether a yes-or-no flag was given, the value of a flag
    # or argument that takes one word, the values of one that takes many, or the tasks of `proof run`.
    type attribute = bool | String | Array[String] | Array[TaskWords] | nil

    # The value of any command `proof` takes: one class for each command.
    type command = RunCommand
                 | WatchCommand
                 | LogsCommand
                 | CancelCommand
                 | DownloadCommand
                 | StatusCommand
                 | LoginCommand
                 | LogoutCommand
                 | VerifyCommand
                 | SkillInstallCommand
                 | ServerSetupCommand
                 | ServerUpgradeCommand
                 | ServerUninstallCommand
                 | RunnerSetupCommand
                 | RunnerApproveCommand
                 | RunnerStartCommand
                 | RunnerStopCommand
                 | RunnerListCommand
                 | RunnerRevokeCommand
                 | RunnerUninstallCommand
                 | HookInstallCommand
                 | HookUninstallCommand
  end
end
