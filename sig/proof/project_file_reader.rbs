module Proof
  # Reads a project file's text into a `Proof::ProjectFile`.
  #
  # `.config/proof.kdl` is text that a person writes, in KDL 2. Proof reads it
  # before it sends anything, so a mistake in it stops the run with the line
  # and the reason, and never reaches a runner as a setting nobody meant. The
  # domain refuses a bad label, size, or duration on its own, but it has no
  # line to name, and it doesn't know which nodes and properties the file may
  # have.
  #
  # This class reads the text with `Proof::KdlParser`, checks every node against
  # `Proof::ProjectFileForms` with `Proof::KdlFormCheck`, which refuses a node,
  # property, or child the project file page doesn't list, builds each value
  # with the domain's own classes so that their rules are the file's rules, and
  # raises `Proof::ProjectFileError` for every mistake, with the path, the line
  # of the node it is in, and what is wrong.
  #
  # Use it to turn the text that `Proof::GitProject#file_at` gives into the
  # project file that `Proof::SettingsResolver` reads.
  #
  # ## Examples
  #
  # ```ruby
  # text = <<~KDL
  #   defaults cpus=4 memory="8GB"
  #
  #   task test {
  #     label desktop
  #   }
  # KDL
  # file = Proof::ProjectFileReader.read(text)
  # file.defaults.cpus # => 4
  # file.entry_for("test").settings.labels == Proof::LabelSet.of("desktop") # => true
  # ```
  #
  # A mistake raises an error that names the line:
  #
  # ```ruby
  # begin
  #   Proof::ProjectFileReader.read("task test\ntask lint cpus=\"four\"\n")
  # rescue Proof::ProjectFileError => e
  #   e.line # => 2
  # end
  # ```
  class ProjectFileReader
    # The path of the project file in a project, from its root.
    PATH: String

    # Reads `text` as a project file. Raises `Proof::ProjectFileError` for text
    # that isn't KDL 2, for a node, property, or child the page doesn't list,
    # for a value the domain refuses, for two `task` entries with one name or
    # two `defaults` nodes, for a child given twice or with no arguments, and
    # for a task name or command that is blank. An empty text, or one with
    # only comments, is a project file with nothing in it.
    #
    # - `text`: String, the file's text.
    # - `path`: String, the file's path, for the errors. Defaults to
    #   `Proof::ProjectFileReader::PATH`.
    def self.read: (String text, ?path: String) -> ProjectFile

    # Reads the project file of the commit that `id` identifies in `project`.
    # It is `nil` when the commit has no file at `path`, and also when `path`
    # is a folder or a submodule, as `Proof::GitProject#file_at` gives `nil`.
    # Otherwise it reads the text as `Proof::ProjectFileReader.read` does.
    # Raises `Proof::ProjectFileError`, with the path and no line, when the
    # file is a symbolic link, because Proof reads only a regular file there.
    # Raises what `Proof::GitProject#file_at` raises for a commit the project
    # lacks, a partial clone, and a Git failure.
    #
    # - `project`: Proof::GitProject, the project to read from.
    # - `id`: String, a full commit ID, such as `commit_id` or
    #   `working_tree_commit_id` gives.
    # - `path`: String, the file's path, for the read and for the errors.
    #   Defaults to `Proof::ProjectFileReader::PATH`.
    def self.read_from: (GitProject project, String id, ?path: String) -> ProjectFile?

    # Prepares to read texts as the file at `path`.
    #
    # - `path`: String, the file's path, for the errors.
    def initialize: (path: String) -> void

    # Reads `text` as `Proof::ProjectFileReader.read` does.
    #
    # ```ruby
    # Proof::ProjectFileReader.new(path: ".config/proof.kdl").read("task test\n").entries.size # => 1
    # ```
    def read: (String text) -> ProjectFile

    # Reads the project file of a commit, as `Proof::ProjectFileReader.read_from`
    # does.
    #
    # ```ruby
    # require "tmpdir"
    # Dir.mktmpdir do |folder|
    #   git = ["git", "-C", folder, "-c", "user.name=Ann", "-c", "user.email=ann@example.com"]
    #   system(*git, "init", "--quiet")
    #   Dir.mkdir(File.join(folder, ".config"))
    #   File.write(File.join(folder, ".config", "proof.kdl"), "task test\n")
    #   system(*git, "add", ".config/proof.kdl")
    #   system(*git, "commit", "--quiet", "-m", "First")
    #   project = Proof::GitProject.find(folder)
    #   reader = Proof::ProjectFileReader.new(path: ".config/proof.kdl")
    #   reader.read_from(project, project.commit_id("HEAD")).entries.size
    # end
    # # => 1
    # ```
    def read_from: (GitProject project, String id) -> ProjectFile?

    # The project file's description: its path, its error, its forms, and its
    # messages, written once, here. The reader refuses with it, and so can a test
    # or a doc example.
    #
    # ```ruby
    # Proof::ProjectFileReader.new(path: "other.kdl").file.refusal(Proof::ProjectFileRefusal).class # => Proof::ProjectFileRefusal
    # ```
    attr_reader file: KdlFile

    private

    def defaults_of: (KdlNode? node) -> TaskSettings

    def tasks_of: (Array[KdlNode] nodes) -> Array[TaskEntry]

    @path: String
    @file: KdlFile
    @refusal: ProjectFileRefusal
    @settings: ProjectFileSettings

    LINK_REASON: String
  end
end
