module Proof
  # Raises `Proof::ProjectFileError` for each way the shape of a project file
  # can be wrong, with the message for it.
  #
  # A refusal names a file and a line, and the reader would repeat both at every
  # place it refuses something. The wording is the person's whole help in fixing
  # the file, so it sits in one place, where it can be read as a list.
  #
  # This class holds the file's path, and has one method for each refusal of a
  # node as a whole: a node the page doesn't list, a second `defaults`, and a
  # task entry with the wrong arguments. Each method raises, and never returns.
  # It also turns what the domain refuses into the same error, at the line of the
  # node it was building.
  #
  # Use it from the classes that read a project file's nodes.
  class ProjectFileRefusal < FileRefusal
    # The messages, by name, for `format` to fill in.
    MESSAGES: Hash[Symbol, String]

    # Prepares to refuse as the file at `path`.
    #
    # - `path`: String, the file's path.
    def initialize: (path: String, ?messages: Hash[Symbol, String]) -> void

    # - `messages`: Hash from a message's name to its text. Defaults to
    #   `MESSAGES`, and a subclass with messages of its own passes them.

    # Refuses a top-level node that isn't `defaults` or `task`.
    def unknown_node: (KdlNode node) -> bot

    # Refuses a second `defaults` node. `first` is the node before it.
    def repeated_defaults: (KdlNode node, KdlNode first) -> bot

    # Refuses a second `task` entry named `name`. `first` is the entry before it.
    def repeated_task: (KdlNode node, KdlNode first) -> bot

    # Refuses arguments on a `defaults` node.
    def defaults_arguments: (KdlNode node) -> bot

    # Refuses a `task` with no name, or with more than a name and a command.
    def task_arguments: (KdlNode node, Integer count) -> bot

    # Refuses a task name that is empty or only white space.
    def blank_name: (KdlNode node, kdl_value name) -> bot

    # Refuses a command that is empty or only spaces.
    def blank_command: (KdlNode node, kdl_value command) -> bot
  end
end
