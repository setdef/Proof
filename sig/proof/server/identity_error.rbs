module Proof
  module Server
    # Raised when the server's key or certificate can't be used.
    #
    # The server is known by its key to every computer and runner that trusts
    # it, so a key file that is missing, damaged, or of another kind can't be
    # replaced quietly: every one of them would refuse the server.
    #
    # The message names the file and says what to do about it.
    #
    # ## Examples
    #
    # ```ruby
    # error = Proof::Server::IdentityError.new("key.pem isn't a private key in PEM.")
    # error.message # => "key.pem isn't a private key in PEM."
    # ```
    class IdentityError < Error
    end
  end
end
