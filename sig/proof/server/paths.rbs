module Proof
  module Server
    # Where the server finds the pool file and keeps what it makes.
    #
    # The server runs as an account set aside for Proof, as a service of that
    # account, with no folder of its own named anywhere. A person edits the
    # pool file, and the server's key, certificate, and runs are what it
    # makes and keeps.
    #
    # This class gives both paths as the XDG Base Directory Specification
    # has them: the pool file in `proof/pool.kdl` under `$XDG_CONFIG_HOME`, and
    # the server's own files in `proof/server` under `$XDG_DATA_HOME`. A
    # variable that is unset, empty, or not an absolute path counts as unset,
    # and the folder is then `~/.config` or `~/.local/share`, with `~` the
    # account's home. This holds on Linux and on macOS alike.
    #
    # Use it to find the server's files for an account.
    #
    # ## Examples
    #
    # <!-- skip-example: reads XDG_DATA_HOME and XDG_CONFIG_HOME from the environment of the process that runs it -->
    # ```ruby
    # paths = Proof::Server::Paths.find("/home/proof")
    # paths.pool_file # => "/home/proof/.config/proof/pool.kdl"
    # paths.folder # => "/home/proof/.local/share/proof/server"
    # ```
    class Paths < Data
      # The pool file's path under the config folder.
      POOL_FILE: String

      # The server's folder under the data folder.
      FOLDER: String

      # The pool file's path.
      attr_reader pool_file: String

      # The folder of the server's key, certificate, and runs.
      attr_reader folder: String

      # The paths for the account whose home is `home`, from the environment
      # of this process.
      #
      # - `home`: String, the home folder of the server's account.
      def self.find: (String home) -> Paths

      # Holds `pool_file` and `folder`.
      #
      # - `pool_file`: String, the pool file's path.
      # - `folder`: String, the server's folder.
      def initialize: (pool_file: String, folder: String) -> void

      def self.new: (pool_file: String, folder: String) -> Paths
                  | (String pool_file, String folder) -> Paths
    end
  end
end
