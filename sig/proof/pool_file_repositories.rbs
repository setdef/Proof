module Proof
  # Reads the `repository` nodes of the pool file.
  #
  # A repository entry is its name, its URL, its credentials file, its branches,
  # its tasks, and its poll. The domain holds each rule, but it has no line to
  # name, and KDL accepts a repository with a blank name or URL.
  #
  # This class refuses a blank name, URL, credentials file, branch, and task,
  # and builds each `Proof::RepositoryEntry` with `Proof::PoolFileRepository`, so
  # that what the domain refuses is refused at the line of the repository.
  #
  # Use it from `Proof::PoolFileReader`.
  class PoolFileRepositories
    # For each child whose arguments may be blank, what its arguments are, for
    # the message.
    BLANKS: Hash[Symbol, String]

    # Prepares to read with `refusal`.
    #
    # - `refusal`: `Proof::PoolFileRefusal`.
    def initialize: (refusal: PoolFileRefusal) -> void

    # The entry of each `repository` node, in order.
    #
    # - `by_name`: Hash from a node's name as a symbol to the nodes of that name,
    #   which `Proof::PoolFileShape` has checked.
    #
    # ```ruby
    # path = "pool.kdl"
    # text = "repository lota url=\"https://example.com/lota.git\" {\n  branch trunk\n  task test\n}\n"
    # by_name = Proof::KdlParser.parse(text, path:, error: Proof::PoolFileError).group_by { |node| node.name.to_sym }
    # Proof::PoolFileRepositories.new(refusal: Proof::PoolFileRefusal.new(path:)).read(by_name)[:repositories].map(&:name) # => ["lota"]
    # ```
    def read: (Hash[Symbol, Array[KdlNode]] by_name) -> Hash[Symbol, Object]

    private

    def entry: (KdlNode node) -> RepositoryEntry

    def refuse_blanks: (KdlNode node) -> void

    @refusal: PoolFileRefusal
    @names: PoolFileNames
  end
end
