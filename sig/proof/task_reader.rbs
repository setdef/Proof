module Proof
  # Reads a `task` node into a `Proof::TaskEntry`.
  #
  # A `task` node is `task NAME` or `task NAME COMMAND`, plus the settings that
  # `defaults` takes. A blank name or command would reach a runner as a task
  # that can't run, and KDL accepts both.
  #
  # This class refuses a command that is empty or only white space, and a second
  # entry with the name of an earlier one. It reads the settings with
  # `Proof::ProjectFileSettings` and builds the entry, which refuses a name that
  # is empty or only white space, at the line of the node.
  # `Proof::KdlFormCheck` has refused a task with no name or with more than a
  # name and a command before.
  #
  # Use it from `Proof::ProjectFileReader`.
  class TaskReader
    # Prepares to read with a refusal and a reader of settings.
    #
    # - `refusal`: `Proof::ProjectFileRefusal`.
    # - `settings`: `Proof::ProjectFileSettings`.
    def initialize: (refusal: ProjectFileRefusal, settings: ProjectFileSettings) -> void

    # The entries that the `task` nodes give, in order. Refuses a second entry
    # with the name of an earlier one, at the line of the second.
    #
    # - `nodes`: Array of `Proof::KdlNode`, the `task` nodes, which
    #   `Proof::KdlFormCheck` has checked.
    #
    # ```ruby
    # path = ".config/proof.kdl"
    # nodes = Proof::KdlParser.parse("task test\ntask lint\n", path:, error: Proof::ProjectFileError)
    # refusal = Proof::ProjectFileReader.new(path:).file.refusal(Proof::ProjectFileRefusal)
    # reader = Proof::TaskReader.new(refusal:, settings: Proof::ProjectFileSettings.new(refusal:))
    # reader.read_all(nodes).map(&:name) # => ["test", "lint"]
    # ```
    def read_all: (Array[KdlNode] nodes) -> Array[TaskEntry]

    # The entry that `node` gives.
    #
    # - `node`: `Proof::KdlNode`, a `task` node that `Proof::KdlFormCheck` has
    #   checked.
    #
    # ```ruby
    # path = ".config/proof.kdl"
    # node = Proof::KdlParser.parse("task docs \"make docs\"\n", path:, error: Proof::ProjectFileError).first
    # refusal = Proof::ProjectFileReader.new(path:).file.refusal(Proof::ProjectFileRefusal)
    # entry = Proof::TaskReader.new(refusal:, settings: Proof::ProjectFileSettings.new(refusal:)).read(node)
    # [entry.name, entry.command] # => ["docs", "make docs"]
    # ```
    def read: (KdlNode node) -> TaskEntry

    private

    def refuse_repeats_among: (Array[KdlNode] nodes) -> void

    def refuse_repeat: (Array[KdlNode] same) -> void

    BLANK: ^(kdl_value) -> bool

    @refusal: ProjectFileRefusal
    @settings: ProjectFileSettings
  end
end
