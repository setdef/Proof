module Proof
  # Reads the children of a `defaults` or `task` node: `os`, `label`,
  # `artifact`, and `cache`.
  #
  # The page lists four children, each with one or more arguments, and each given
  # once. KDL accepts anything else without complaint, so a misspelled child or a
  # second `os` would be dropped or would override the first, and a task would run
  # on systems nobody meant. The domain owns what the arguments mean.
  #
  # This class refuses a child the page doesn't list, a child given twice, a child
  # with no arguments, and a child with a property or a block. It builds each
  # child's value with the domain's classes: operating systems, a set of labels,
  # and path patterns for artifacts and caches. A value the domain refuses is a
  # refusal at the line of the child.
  #
  # Use it from `Proof::ProjectFileSettings`.
  #
  # ## Examples
  #
  # ```ruby
  # path = ".config/proof.kdl"
  # node = Proof::KdlParser.parse("task test {\n  os linux macos\n  cache \"tmp/build\"\n}\n", path:).first
  # children = Proof::ProjectFileChildren.new(refusal: Proof::ProjectFileSettingsRefusal.new(path:))
  # children.read(node).keys # => [:os, :caches]
  # ```
  class ProjectFileChildren
    # The names of the children the page lists.
    NAMES: Array[String]

    # Prepares to read with `refusal`.
    #
    # - `refusal`: `Proof::ProjectFileSettingsRefusal`.
    def initialize: (refusal: ProjectFileSettingsRefusal) -> void

    # The settings that the children of `node` give, by the name of the member of
    # `Proof::TaskSettings`. Refuses the first mistake among the children, in the
    # order the file has them. A node with no children gives `{}`.
    #
    # - `node`: `Proof::KdlNode`, a `defaults` or `task` node.
    def read: (KdlNode node) -> Hash[Symbol, Object]

    private

    def check: (KdlNode parent, KdlNode child, KdlNode? first) -> void

    def refuse_unknown: (KdlNode parent, KdlNode child) -> void

    def refuse_shape: (KdlNode child) -> void

    def pair: (KdlNode child, Symbol key) -> [Symbol, Object]

    MEMBERS: Hash[Symbol, Symbol]

    BUILDERS: Hash[Symbol, ^(Array[kdl_value]) -> Object]

    @refusal: ProjectFileSettingsRefusal
  end
end
