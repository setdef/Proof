module Proof
  # The form of each node of the pool file that the reader reads.
  #
  # The pool file page lists the nodes of the file, and the children and
  # properties of each. This constant is that list as data, one
  # `Proof::KdlForm` for each node, so that the check of a node's form is the
  # same code for each, and a node the page gains is a line here.
  #
  # Use it to find the form of a node by its name.
  #
  # ## Examples
  #
  # ```ruby
  # Proof::PoolFileForms[:host].arguments # => 1..1
  # Proof::PoolFileForms[:defaults].children # => [:budget, :"keep-free", :share, :"active-for", :withhold]
  # Proof::PoolFileForms[:cluster] # => nil
  # ```
  PoolFileForms: KdlForms
end
