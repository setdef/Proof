module Proof
  # Reads the properties of a `defaults` or `task` node: `cpus`, `memory`, and
  # `timeout`.
  #
  # A property that the page doesn't list, such as `cpu=4`, is a typo that KDL
  # accepts, and a task would run with the built-in value while the person
  # believes it has theirs.
  #
  # This class refuses a property the page doesn't list, with the child's way
  # when the name is a child's, and builds each value with the domain's own
  # classes, so a size, a duration, and a count of CPUs have one rule each.
  #
  # Use it from `Proof::ProjectFileSettings`.
  #
  # ## Examples
  #
  # ```ruby
  # path = ".config/proof.kdl"
  # node = Proof::KdlParser.parse("task test cpus=4 timeout=\"90s\"\n", path:).first
  # properties = Proof::ProjectFileProperties.new(refusal: Proof::ProjectFileSettingsRefusal.new(path:))
  # properties.read(node).keys # => [:cpus, :time_limit]
  # ```
  class ProjectFileProperties
    # The member of `Proof::TaskSettings` that each property gives.
    KEYS: Hash[Symbol, Symbol]

    # What each property builds from its value.
    BUILDERS: Hash[Symbol, ^(kdl_value) -> Object]

    # Prepares to read with `refusal`.
    #
    # - `refusal`: `Proof::ProjectFileSettingsRefusal`.
    def initialize: (refusal: ProjectFileSettingsRefusal) -> void

    # The settings that the properties of `node` give, by the name of the member
    # of `Proof::TaskSettings`.
    #
    # - `node`: `Proof::KdlNode`, a `defaults` or `task` node.
    def read: (KdlNode node) -> Hash[Symbol, Object]

    private

    def refuse_unknown_in: (KdlNode node) -> void

    def refuse: (KdlNode node, String name) -> void

    def pair: (KdlNode node, Symbol key, kdl_value value) -> [Symbol, Object]

    @refusal: ProjectFileSettingsRefusal
  end
end
