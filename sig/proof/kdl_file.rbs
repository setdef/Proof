module Proof
  # One of Proof's KDL files, described by its path, its error, its forms, and
  # its refusal class.
  #
  # The project file and the pool file are each KDL that a person writes, and
  # each is read the same way: the text is parsed into nodes, every node is
  # checked against its form, and a mistake is refused in the file's words, with
  # the file's path and error. Those four facts describe one file, and each step
  # of the reading needs some of them, so they travel together. The refusal class
  # has the file's messages, so a file's refusal can't have another file's.
  #
  # This class holds them. It builds the file's refusal, and reads the file's
  # text into its checked nodes, grouped by name. It reads no value from a
  # node: that is the work of the reader of the kind of file.
  #
  # The reader of a kind of KDL file names the file's description once, in its
  # `#file`, and the refusal and the tests of that kind of file take it from
  # there. Use a value of this class from the reader of a kind of KDL file.
  #
  # ## Examples
  #
  # ```ruby
  # file = Proof::PoolFileReader.new(path: "pool.kdl").file
  # refusal = file.refusal
  # file.nodes_by_name("server port=8443\nlimits\n", refusal:).keys # => [:server, :limits]
  # ```
  #
  # A mistake in the text is refused at its line, with the file's path:
  #
  # ```ruby
  # # Wrong: raises Proof::PoolFileError
  # file.nodes_by_name("cluster\n", refusal:)
  # ```
  class KdlFile[R < KdlRefusal] < Data
    # What a file's refusal class is: it builds the refusal from the file's
    # facts, and has the messages of its kind of file.
    interface _RefusalClass[R]
      # Builds a refusal, as `Proof::KdlRefusal.new` does.
      def new: (path: String, error: singleton(FileError), messages: Hash[Symbol, String], forms: KdlForms) -> R

      # The messages of the kind of file, by name, for `format` to fill in.
      def messages: () -> Hash[Symbol, String]
    end

    # The file's path, for its errors.
    attr_reader path: String

    # The `Proof::FileError` subclass that the file's mistakes raise.
    attr_reader error: singleton(FileError)

    # The forms of the file's nodes.
    attr_reader forms: KdlForms

    # The class of the file's refusals, such as `Proof::PoolFileRefusal`, which
    # has the file's messages and the refusals only that kind of file has.
    attr_reader refusal_class: _RefusalClass[R]

    # Describes a KDL file.
    #
    # - `path`: String, the file's path.
    # - `error`: the `Proof::FileError` subclass to raise.
    # - `forms`: `Proof::KdlForms`, the forms of the file's nodes.
    # - `refusal_class`: the `Proof::KdlRefusal` subclass for the kind of file,
    #   such as `Proof::PoolFileRefusal`.
    def self.new: [R < KdlRefusal] (path: String, error: singleton(FileError), forms: KdlForms, refusal_class: _RefusalClass[R]) -> KdlFile[R]
                | [R < KdlRefusal] (String path, singleton(FileError) error, KdlForms forms, _RefusalClass[R] refusal_class) -> KdlFile[R]

    # Gives the refusal of this file: a `refusal_class` that has the file's
    # path, error, messages, and forms.
    def refusal: () -> R

    # Reads `text` and gives its nodes, checked against the file's forms and
    # grouped by name, with each group in the order the file has it. A name the
    # file doesn't use has no group. Raises the file's error at the line of the
    # first mistake: text that isn't KDL 2, and then the first node, property,
    # or child that its form refuses.
    #
    # - `text`: String, the file's text.
    # - `refusal`: `Proof::KdlRefusal`, from `#refusal`, which the check refuses
    #   with.
    def nodes_by_name: (String text, refusal: KdlRefusal) -> Hash[Symbol, Array[KdlNode]]
  end
end
