module Proof
  module Sqlite
    # The store of runs in a SQLite file.
    #
    # The server places runs from several fibers or threads, and every one of
    # them reads a run, decides, and writes. A store that let two of them write
    # from the same read would place a run twice. SQLite has to refuse the
    # second, and the server has to keep its runs when it restarts.
    #
    # This class keeps each run's facts in order, one row for each, with the
    # server's time on it. It rebuilds a run from its rows on every read, as
    # `Proof::InMemory::Runs` does, so a row changed behind Proof's back raises
    # `Proof::InvalidRunError` or `Proof::InvalidFactError` instead of loading.
    # It adds a fact only at the version the caller read: a write inserts the
    # row for version `read + 1`, and SQLite refuses a second row there because
    # of a unique index on the run and the version. A second unique index makes
    # SQLite refuse a second placement whatever its version, and a third a
    # second run at one queue position. The class turns each refusal into the
    # error `Proof::_Runs` names. Each write is one transaction. It passes
    # `Proof::Testing::RunsContract`.
    #
    # Each call that reads costs a read of every row it needs, and `queued`,
    # `holding_resources`, and `next_position` read every run. The store has no
    # lock of its own: SQLite's write lock lets one write at a time insert, and
    # a write that waits for the lock sleeps in Ruby, so another thread or
    # fiber runs meanwhile.
    #
    # Use it as the server's store of runs, with the file on a disk of the
    # server's computer, never on a network share.
    #
    # ## Examples
    #
    # ```ruby
    # runs = Proof::Sqlite::Runs.new(path: "runs.db")
    # queued = Proof::Run::Queued.new(
    #   at: Time.utc(2026, 11, 25, 3, 36), position: runs.next_position, os: [Proof::OS.new(name: :linux)],
    #   labels: Proof::LabelSet.of, resources: Proof::Resources.request(cpus: 2, memory: "4GB")
    # )
    # id = Proof::RunId.parse("20261125-0336-m3d8q")
    # runs.add(Proof::Run.new(id:, facts: [queued]))
    # placed = Proof::Run::Placed.new(at: Time.utc(2026, 11, 25, 3, 36), host: "nuc", runner: "nuc-linux")
    # runs.append(id, placed, version: 1).state # => :running
    # runs.close
    # ```
    #
    # A second placement is refused, whatever version it is given:
    #
    # ```ruby
    # # Wrong: raises Proof::RunAlreadyPlacedError
    # runs = Proof::Sqlite::Runs.new(path: "runs.db")
    # other = Proof::Run::Placed.new(at: Time.utc(2026, 11, 25, 3, 36), host: "pc", runner: "pc-wsl")
    # runs.append(id, other, version: 2)
    # ```
    #
    # A store opened on the same file after a restart has the same runs:
    #
    # ```ruby
    # runs.close
    # reopened = Proof::Sqlite::Runs.new(path: "runs.db")
    # reopened.find(id).state # => :running
    # reopened.close
    # ```
    class Runs
      # The path of the SQLite file.
      attr_reader path: String

      # Opens the file at `path`, and makes it if it isn't there. Runs each
      # migration the file hasn't had, so a new file gets its tables and an
      # old one keeps its rows. Raises what Sequel raises when `path` is in a
      # folder that isn't there or can't be written.
      #
      # - `path`: String, the SQLite file's path.
      def initialize: (path: String) -> void

      # Closes every connection the store opened. A store that is closed isn't
      # used again.
      #
      # ```ruby
      # Proof::Sqlite::Runs.new(path: "closed.db").close
      # ```
      def close: () -> void

      # Tells `logger` about each statement the store runs, after it runs, as
      # Sequel does: `info` for a statement that worked, and `error` for one
      # the database refused.
      #
      # - `logger`: an object that has `info`, `warn`, and `error`, each taking
      #   the statement as a `String`.
      #
      # ```ruby
      # class Statements
      #   attr_reader :seen
      #
      #   def initialize
      #     @seen = []
      #   end
      #
      #   def info(statement)
      #     @seen << statement
      #   end
      #
      #   def warn(statement); end
      #
      #   def error(statement); end
      # end
      #
      # runs = Proof::Sqlite::Runs.new(path: "logged.db")
      # statements = Statements.new
      # runs.use_logger(statements)
      # runs.next_position # => 1
      # statements.seen.size # => 1
      # runs.close
      # ```
      def use_logger: (ROM::SQL::_Logger logger) -> void

      # Stores a new run, as `Proof::_Runs` says. The run's facts go in one
      # transaction, so a refused run leaves none of them.
      #
      # ```ruby
      # runs = Proof::Sqlite::Runs.new(path: "added.db")
      # queued = Proof::Run::Queued.new(
      #   at: Time.utc(2026, 11, 25, 3, 36), position: 1, os: [Proof::OS.new(name: :linux)],
      #   labels: Proof::LabelSet.of, resources: Proof::Resources.request(cpus: 2, memory: "4GB")
      # )
      # runs.add(Proof::Run.new(id: Proof::RunId.parse("20261125-0336-m3d8q"), facts: [queued])) # => nil
      # runs.close
      # ```
      def add: (Run run) -> nil

      # The stored run with `id`, rebuilt from its rows, or `nil`.
      #
      # ```ruby
      # runs = Proof::Sqlite::Runs.new(path: "found.db")
      # runs.find(Proof::RunId.parse("20261125-0336-m3d8q")) # => nil
      # runs.close
      # ```
      def find: (RunId id) -> Run?

      # Adds `fact` to the run with `id` at `version`, as `Proof::_Runs` says.
      # It reads the run, checks the fact against it, and inserts the row for
      # version `version + 1`. When another writer inserted that row, or a
      # placement, between the read and the insert, SQLite refuses the insert
      # because of a unique index, and the error is the one for what the other
      # writer stored:
      # `Proof::RunAlreadyPlacedError` when the run is placed, and
      # `Proof::RunChangedError` when it isn't.
      #
      # ```ruby
      # runs = Proof::Sqlite::Runs.new(path: "appended.db")
      # id = Proof::RunId.parse("20261125-0336-m3d8q")
      # queued = Proof::Run::Queued.new(
      #   at: Time.utc(2026, 11, 25, 3, 36), position: 1, os: [Proof::OS.new(name: :linux)],
      #   labels: Proof::LabelSet.of, resources: Proof::Resources.request(cpus: 2, memory: "4GB")
      # )
      # runs.add(Proof::Run.new(id:, facts: [queued]))
      # runs.append(id, Proof::Run::CancelAsked.new(at: Time.utc(2026, 11, 25, 3, 37)), version: 1).version # => 2
      # runs.close
      # ```
      def append: (RunId id, Run::Fact fact, version: Integer) -> Run

      # The queued runs, earliest queue position first.
      #
      # ```ruby
      # runs = Proof::Sqlite::Runs.new(path: "queued.db")
      # runs.queued # => []
      # runs.close
      # ```
      def queued: () -> Array[Run]

      # The runs that hold their host's CPUs and memory, earliest queue
      # position first.
      #
      # ```ruby
      # runs = Proof::Sqlite::Runs.new(path: "holding.db")
      # runs.holding_resources # => []
      # runs.close
      # ```
      def holding_resources: () -> Array[Run]

      # One more than the largest stored queue position, or 1.
      #
      # ```ruby
      # runs = Proof::Sqlite::Runs.new(path: "positions.db")
      # runs.next_position # => 1
      # runs.close
      # ```
      def next_position: () -> Integer

      @container: ROM::Container

      @facts: Facts

      @writer: Writer

      private

      def all: () -> Array[Run]
    end
  end
end
