module Proof
  class Run
    # The fact that a run ended without a status from its command.
    #
    # The server loses contact with a run's runner, or Proof fails, or the
    # command exits but its whole output never arrives. A run may still be going
    # on a host the server can't reach, so its host's CPUs and memory stay held
    # until its processes end.
    #
    # This fact is the run's final state, `lost`. `Proof::Run` refuses it unless
    # the run was placed. It is the one final state that a fact may follow:
    # `Proof::Run::ProcessesEnded`, once.
    #
    # Use it to record a lost run.
    #
    # ## Examples
    #
    # ```ruby
    # fact = Proof::Run::Lost.new(at: Time.utc(2026, 11, 25, 3, 42))
    # fact.at # => Time.utc(2026, 11, 25, 3, 42)
    # Proof::Run::FINAL_STATES[fact.class] # => :lost
    # ```
    class Lost < Data
      include Fact
      include Final

      # The moment the run reached its final state.
      attr_reader at: Time

      # Builds the fact, and raises `Proof::InvalidFactError` unless `at` is a
      # `Time`.
      #
      # - `at`: Time, from the server's clock.
      def self.new: (at: Time) -> instance
                  | (Time at) -> instance
    end
  end
end
