module Proof
  class Run
    # The fact that a run reached its time limit, and its runner ended it.
    #
    # A run's time limit starts when its command starts, so a run whose command
    # never started can't reach it.
    #
    # This fact is the run's final state, `timed_out`. `Proof::Run` refuses it
    # unless the command started. The command may have ended by a signal first,
    # as the runner ended it.
    #
    # Use it to record that a run reached its time limit.
    #
    # ## Examples
    #
    # ```ruby
    # fact = Proof::Run::TimedOut.new(at: Time.utc(2026, 11, 25, 3, 42))
    # fact.at # => Time.utc(2026, 11, 25, 3, 42)
    # Proof::Run::FINAL_STATES[fact.class] # => :timed_out
    # ```
    class TimedOut < Data
      include Fact
      include Final

      # The moment the run reached its final state.
      attr_reader at: Time

      # Builds the fact, and raises `Proof::InvalidFactError` unless `at` is a
      # `Time`.
      #
      # - `at`: Time, from the server's clock.
      def self.new: (at: Time) -> instance
                  | (Time at) -> instance
    end
  end
end
