module Proof
  class Run
    # The fact that a run held more memory than it requested while its host ran
    # short, and its runner ended it.
    #
    # Only a command that runs can hold memory, and a run ended for memory is
    # never run again.
    #
    # This fact is the run's final state, `out_of_memory`. `Proof::Run` refuses
    # it unless the command started.
    #
    # Use it to record that a run was ended for memory.
    #
    # ## Examples
    #
    # ```ruby
    # fact = Proof::Run::OutOfMemory.new(at: Time.utc(2026, 11, 25, 3, 42))
    # fact.at # => Time.utc(2026, 11, 25, 3, 42)
    # Proof::Run::FINAL_STATES[fact.class] # => :out_of_memory
    # ```
    class OutOfMemory < Data
      include Fact
      include Final

      # The moment the run reached its final state.
      attr_reader at: Time

      # Builds the fact, and raises `Proof::InvalidFactError` unless `at` is a
      # `Time`.
      #
      # - `at`: Time, from the server's clock.
      def self.new: (at: Time) -> instance
                  | (Time at) -> instance
    end
  end
end
