module Proof
  class Run
    # The fact that someone canceled a run, and its runner ended it.
    #
    # A cancel is asked for, and the run is `canceled` only once its runner ends
    # it, so the ask and the end are two facts.
    #
    # This fact is the run's final state, `canceled`. `Proof::Run` refuses it
    # unless a cancel was asked for and the run was placed.
    #
    # Use it to record that a runner ended a run someone canceled.
    #
    # ## Examples
    #
    # ```ruby
    # fact = Proof::Run::Canceled.new(at: Time.utc(2026, 11, 25, 3, 42))
    # fact.at # => Time.utc(2026, 11, 25, 3, 42)
    # Proof::Run::FINAL_STATES[fact.class] # => :canceled
    # ```
    class Canceled < Data
      include Fact
      include Final

      # The moment the run reached its final state.
      attr_reader at: Time

      # Builds the fact, and raises `Proof::InvalidFactError` unless `at` is a
      # `Time`.
      #
      # - `at`: Time, from the server's clock.
      def self.new: (at: Time) -> instance
                  | (Time at) -> instance
    end
  end
end
