module Proof
  class Run
    # The fact that someone canceled a run, and it ended.
    #
    # A cancel is asked for, and the run is `canceled` only once it ends, so the
    # ask and the end are two facts. A runner ends a run it has. A run that is
    # still queued has no runner, and the server ends it.
    #
    # This fact is the run's final state, `canceled`. `Proof::Run` refuses it
    # unless a cancel was asked for. A run canceled while queued has no
    # placement.
    #
    # Use it to record that a run someone canceled ended.
    #
    # ## Examples
    #
    # ```ruby
    # fact = Proof::Run::Canceled.new(at: Time.utc(2026, 11, 25, 3, 42))
    # fact.at # => Time.utc(2026, 11, 25, 3, 42)
    # Proof::Run::FINAL_STATES[fact.class] # => :canceled
    # ```
    class Canceled < Data
      include Fact
      include Final

      # The moment the run reached its final state.
      attr_reader at: Time

      # Builds the fact, and raises `Proof::InvalidFactError` unless `at` is a
      # `Time`.
      #
      # - `at`: Time, from the server's clock.
      def self.new: (at: Time) -> instance
                  | (Time at) -> instance
    end
  end
end
