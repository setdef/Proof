module Proof
  # The settings that a host's entry in the pool file gives, or that its
  # `defaults` node gives every host.
  #
  # A host's disk budget, the disk space it keeps free, the share of its CPUs
  # and memory that Proof keeps for a person, how long a person counts as
  # active, and the labels its runners must not offer each have three sources: the
  # host's entry, the `defaults` node, and Proof's built-in defaults. A host
  # that took only one of them would ignore the other two, and a file with no
  # `defaults` node would leave every host to say everything.
  #
  # This class holds the five settings of one source, each of which a source can
  # leave out, as `nil`. Combine two sources with `over`: a budget, a space
  # to keep free, a share, and a time a person counts as active come from the
  # first source that has one, and the withheld labels add up from both.
  #
  # Use it for each `host` entry, for `defaults`, and for Proof's built-in
  # defaults.
  #
  # ## Examples
  #
  # ```ruby
  # defaults = Proof::HostSettings.new(budget: Proof::Size.read("100GB", name: "budget"))
  # entry = Proof::HostSettings.new(budget: Proof::Size.read("250GB", name: "budget"))
  # entry.over(defaults).budget.megabytes # => 256_000
  # Proof::HostSettings.new.over(defaults).budget.megabytes # => 102_400
  # ```
  #
  # Withheld labels add up:
  #
  # ```ruby
  # defaults = Proof::HostSettings.new(withheld: Proof::LabelSet.of("desktop"))
  # entry = Proof::HostSettings.new(withheld: Proof::LabelSet.of("gpu"))
  # entry.over(defaults).withheld == Proof::LabelSet.of("desktop", "gpu") # => true
  # ```
  #
  # A share of no CPUs and no memory is a setting:
  #
  # ```ruby
  # Proof::HostSettings.new(share: Proof::Resources.new(cpus: 0, megabytes: 0)).share.cpus # => 0
  # ```
  #
  # A setting of the wrong kind is refused:
  #
  # ```ruby
  # # Wrong: raises Proof::InvalidHostSettingsError
  # Proof::HostSettings.new(budget: "400GB")
  # ```
  class HostSettings < Data
    # For each member, the start of the message when its value is not of its
    # kind, which `format` completes with what the value was.
    MESSAGES: Hash[Symbol, String]

    # The class each member holds.
    KINDS: Hash[Symbol, Class]

    # The disk space Proof may use on the host, or `nil` when the source gives
    # none.
    attr_reader budget: Size?

    # The disk space the host's runners always leave free, or `nil`.
    attr_reader keep_free: Size?

    # The CPUs and memory Proof keeps free on the host for a person, or `nil`.
    attr_reader share: Resources?

    # How long after the last use of the host's input devices a person still
    # counts as active, or `nil`.
    attr_reader active_for: Duration?

    # The labels the host's runners must not offer, or `nil` when the source
    # withholds none.
    attr_reader withheld: LabelSet?

    def self.new: (?budget: Size?, ?keep_free: Size?, ?share: Resources?, ?active_for: Duration?, ?withheld: LabelSet?) -> instance
                | (?Size? budget, ?Size? keep_free, ?Resources? share, ?Duration? active_for, ?LabelSet? withheld) -> instance

    # Builds one source's settings, and raises `Proof::InvalidHostSettingsError`
    # unless each setting that isn't `nil` is of its kind. A setting left out,
    # or given as `nil`, is one the source doesn't give. Settings that give
    # nothing are what a source with no such child has.
    #
    # - `budget`: Size or `nil`.
    # - `keep_free`: Size or `nil`.
    # - `share`: Resources or `nil`. It may be 0 CPUs and 0 megabytes.
    # - `active_for`: Duration or `nil`.
    # - `withheld`: LabelSet or `nil`.
    #
    # ```ruby
    # Proof::HostSettings.new.budget # => nil
    # ```
    def initialize: (?budget: Size?, ?keep_free: Size?, ?share: Resources?, ?active_for: Duration?, ?withheld: LabelSet?) -> void

    # These settings over `lower`. A budget, a space to keep free, a share, and a
    # time a person counts as active come from these settings when they have
    # one, and from `lower` when they don't. A share is taken as a whole, never
    # CPUs from one source and memory from the other. The withheld labels of
    # both add up, and are `nil` only when neither source withholds any.
    #
    # - `lower`: HostSettings, the source to fall back on.
    #
    # ```ruby
    # entry = Proof::HostSettings.new(share: Proof::Resources.new(cpus: 4, megabytes: 16_384))
    # defaults = Proof::HostSettings.new(share: Proof::Resources.new(cpus: 2, megabytes: 4096))
    # entry.over(defaults).share.megabytes # => 16_384
    # ```
    def over: (HostSettings lower) -> HostSettings
  end
end
