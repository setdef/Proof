module Proof
  # The written form of a duration, such as `"90s"` or `"2h"`, read into whole
  # seconds.
  #
  # `Proof::TimeLimit.read` reads a timeout with it. It is a separate module so
  # that the form is checked in one place, and so that `TimeLimit` holds only
  # what a time limit is. It is a private constant of `Proof`, so the domain has
  # no public name for it: read a duration with `Proof::TimeLimit.read`.
  #
  # A duration is a whole number from 1 and one unit, with no space, in
  # lowercase. Each caller names the units it accepts, from `d` for days, `h`
  # for hours, `m` for minutes, and `s` for seconds. A unit that the caller
  # doesn't name is refused, even when it is one of these four.
  module DurationText
    # The seconds in one of each unit, by the unit's letter as a symbol.
    SECONDS: Hash[Symbol, Integer]

    # The seconds in `text`, or `nil` when `text` isn't a duration in one of
    # the units in `units`. A value that isn't text, text with a byte that
    # isn't valid text, and text in an encoding that isn't ASCII-compatible,
    # such as UTF-16, give `nil`.
    #
    # - `text`: Object, such as `"90s"`. Any value is accepted, and only a
    #   String in the form gives a number.
    # - `units`: Array of Symbol, the units that count, such as `[:s, :m, :h]`.
    def self.seconds: (Object text, Array[Symbol] units) -> Integer?

    private def self.form: (Array[Symbol] units) -> Regexp
  end
end
