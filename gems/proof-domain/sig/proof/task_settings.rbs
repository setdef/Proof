module Proof
  # The settings one source gives a run: a task's entry in the project file,
  # the `defaults` node, or the flags of `proof run`.
  #
  # A run's settings come from four sources, and each source gives some
  # settings and leaves the others out. A bare `0` or `nil` for a setting that
  # was left out would look like a value, so the first source that has a setting
  # couldn't be found.
  #
  # Each setting here is either given or `nil`, which means this source has
  # nothing to say about it. The operating systems, the labels, the CPUs, the
  # memory in megabytes, the time limit, the artifacts, and the caches are the
  # settings. A setting that is given is checked when you build the settings, so
  # a source with a mistake can't exist. This class doesn't decide which source
  # wins.
  #
  # Use it for what one `task` entry, one `defaults` node, or the flags of one
  # command give.
  #
  # ## Examples
  #
  # The `defaults` node of the project file page's complete example:
  #
  # ```ruby
  # defaults = Proof::TaskSettings.new(
  #   os: Proof::OS.all, cpus: 4, megabytes: 8192, time_limit: Proof::TimeLimit.read("45m"),
  #   caches: [Proof::PathPattern.new(path: "tmp/engine/build")]
  # )
  # defaults.cpus # => 4
  # defaults.labels # => nil
  # ```
  #
  # A source that gives nothing leaves every setting `nil`:
  #
  # ```ruby
  # Proof::TaskSettings.none.cpus # => nil
  # ```
  #
  # An empty list of operating systems is refused, because a task works on at
  # least one:
  #
  # ```ruby
  # # Wrong: raises Proof::InvalidTaskSettingsError
  # Proof::TaskSettings.new(os: [])
  # ```
  class TaskSettings < Data
    # The message that starts the error for each setting that isn't a number,
    # which `format` completes with what the setting was.
    MESSAGES: Hash[Symbol, String]

    # The class each setting that isn't a number holds, or each member of it.
    KINDS: Hash[Symbol, Class]

    # The operating systems the task works on, in a frozen set, or `nil`. A set
    # has at least one.
    attr_reader os: Set[OS]?

    # The labels a runner must have, or `nil`. An empty set is a given setting
    # that asks for none.
    attr_reader labels: LabelSet?

    # The CPUs requested, a whole number from 1, or `nil`.
    attr_reader cpus: Integer?

    # The memory requested in megabytes, a whole number from 0, or `nil`.
    attr_reader megabytes: Integer?

    # How long a run may take, or `nil`.
    attr_reader time_limit: TimeLimit?

    # The patterns of the files to keep after a run succeeds, in a frozen set,
    # or `nil`. An empty set is a given setting that keeps none.
    attr_reader artifacts: Set[PathPattern]?

    # The folders to keep between runs, in a frozen set, or `nil`. An empty set
    # is a given setting that keeps none.
    attr_reader caches: Set[PathPattern]?

    def self.new: (?os: Array[OS] | Set[OS] | nil, ?labels: LabelSet?, ?cpus: Integer?, ?megabytes: Integer?, ?time_limit: TimeLimit?, ?artifacts: Array[PathPattern] | Set[PathPattern] | nil, ?caches: Array[PathPattern] | Set[PathPattern] | nil) -> instance
                | (?(Array[OS] | Set[OS] | nil) os, ?LabelSet? labels, ?Integer? cpus, ?Integer? megabytes, ?TimeLimit? time_limit, ?(Array[PathPattern] | Set[PathPattern] | nil) artifacts, ?(Array[PathPattern] | Set[PathPattern] | nil) caches) -> instance

    # A source that gives no setting.
    #
    # ```ruby
    # Proof::TaskSettings.none == Proof::TaskSettings.new # => true
    # ```
    def self.none: () -> TaskSettings

    # Builds the settings one source gives, and raises an error for the first
    # one that breaks its rule. Every argument is optional, and `nil` means the
    # source doesn't give that setting.
    #
    # - `os`: an `Array` or `Set` of `Proof::OS`, at least one, or `nil`.
    # - `labels`: a `Proof::LabelSet`, or `nil`.
    # - `cpus`: Integer from 1, or `nil`.
    # - `megabytes`: Integer from 0, or `nil`.
    # - `time_limit`: a `Proof::TimeLimit`, or `nil`.
    # - `artifacts`: an `Array` or `Set` of `Proof::PathPattern`, or `nil`.
    # - `caches`: an `Array` or `Set` of `Proof::PathPattern`, or `nil`.
    #
    # It raises `Proof::InvalidTaskSettingsError` for `os`, `labels`,
    # `time_limit`, `artifacts`, or `caches` that isn't what is listed above,
    # and `Proof::InvalidResourcesError` for `cpus` or `megabytes` that isn't
    # a whole number in range, as `Proof::Resources` refuses them.
    #
    # ```ruby
    # Proof::TaskSettings.new(labels: Proof::LabelSet.of("desktop")).labels.labels.size # => 1
    # ```
    def initialize: (?os: Array[OS] | Set[OS] | nil, ?labels: LabelSet?, ?cpus: Integer?, ?megabytes: Integer?, ?time_limit: TimeLimit?, ?artifacts: Array[PathPattern] | Set[PathPattern] | nil, ?caches: Array[PathPattern] | Set[PathPattern] | nil) -> void

    private

    def setting: (Symbol name, Object? value) -> Object?

    def single: (Symbol name, Object value) -> Object

    def listed: (Symbol name, Object values) -> Set[Object]
  end
end
