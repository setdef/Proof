module Proof
  # The base of every error the domain raises on purpose.
  #
  # A value that checks its rules when you build it raises a subclass of this
  # class for the rule it broke. Rescue `Proof::Error` to catch any rule the
  # domain enforces, and rescue a subclass to catch one rule.
  #
  # ## Examples
  #
  # ```ruby
  # Proof::InvalidOSError.ancestors.include?(Proof::Error) # => true
  # ```
  class Error < StandardError
  end

  # Raised when a value isn't one of the operating systems `linux`, `macos`,
  # and `windows`.
  class InvalidOSError < Error
  end

  # Raised when a label isn't 1 to 63 ASCII letters, digits, hyphens,
  # underscores, and dots, beginning and ending with a letter or a digit.
  class InvalidLabelError < Error
  end

  # Raised when a set of labels is built from anything but labels.
  class InvalidLabelSetError < Error
  end

  # Raised when the tasks of one run have no operating system in common, so no
  # runner could take them all together. The message lists each task's
  # operating systems.
  class NoSharedOSError < Error
    # Builds the error, with a message that lists each task's operating systems
    # and what to do next.
    #
    # - `operating_systems`: Hash from each task's name to a set of its
    #   `Proof::OS` values, in the order of the command line.
    def initialize: (operating_systems: Hash[String, Set[OS]]) -> void
  end

  # Raised when a project file's defaults aren't `Proof::TaskSettings`, its
  # entries aren't an `Array` of `Proof::TaskEntry`, or two entries have one
  # name.
  class InvalidProjectFileError < Error
  end

  # Raised when a number of CPUs isn't a whole number (from 1 for a request,
  # from 0 for any other resources), or an amount of memory isn't a size: a
  # number, an optional space, and `MB`, `GB`, `TB`, `MiB`, `GiB`, or `TiB` in
  # any case, such as `"512MB"` or `"1.5 GiB"`.
  class InvalidResourcesError < Error
  end

  # Raised when a run ID, or the five characters that identify a run, doesn't
  # have the form `20261125-0336-m3d8q`.
  class InvalidRunIdError < Error
  end

  # Raised when an artifact pattern or a cache folder isn't a path relative to
  # the workspace's root: it is empty, starts with `/`, has a folder named
  # `..`, or isn't text.
  class InvalidPathPatternError < Error
  end

  # Raised when a run's settings can't be worked out: the resolver was given
  # something that isn't a project file or flags, the task names aren't a list
  # of one or more names, a setting of the run is missing, or its commands
  # aren't a command or `nil` for each task name.
  class InvalidRunSettingsError < Error
  end

  # Raised when a task entry's name isn't text, its command is neither text nor
  # `nil`, or its settings aren't `Proof::TaskSettings`.
  class InvalidTaskEntryError < Error
  end

  # Raised when one source's settings hold something that isn't a setting:
  # operating systems that are not a list of `Proof::OS` values with at least
  # one, labels that are not a `Proof::LabelSet`, a time limit that is not a
  # `Proof::TimeLimit`, or artifacts or caches that are not lists of
  # `Proof::PathPattern` values. A number of CPUs or megabytes that breaks its
  # rule raises `Proof::InvalidResourcesError`.
  class InvalidTaskSettingsError < Error
  end

  # Raised when a time limit isn't a duration: a whole number from 1 and one
  # unit, `s`, `m`, or `h` in lowercase, with no space, such as `"90s"`,
  # `"30m"`, or `"2h"`.
  class InvalidTimeLimitError < Error
  end

  # Raised when a source of randomness answers with anything but a whole
  # number from 0 up to, and not including, the limit it was asked for.
  class InvalidRandomSourceError < Error
  end

  # Raised when the computer has no `git` program Proof can run. Install Git,
  # or fix `PATH`, and run again.
  class GitNotFoundError < Error
  end

  # Raised when a folder isn't inside a Git repository, so there is no project
  # to find. Proof never guesses which project you meant.
  class NotInRepositoryError < Error
    # Builds the error, with a message that says which folder isn't in a
    # repository and what to do next.
    #
    # - `folder`: String, the folder that was searched.
    # - `git_said`: String or `nil`, what git said when the folder exists.
    #   `nil` means the folder doesn't exist.
    def initialize: (folder: String, ?git_said: String?) -> void
  end

  # Raised when a revision, such as a branch, a tag, or a commit's first digits,
  # isn't a commit the project has. A tree or a file is a revision to Git, and
  # raises this error too.
  class UnknownRevisionError < Error
    # Builds the error, with a message that gives the cause and what to try.
    #
    # - `revision`: String, what the person typed.
    # - `root`: String, the project's root.
    def initialize: (revision: String, root: String) -> void
  end

  # Raised when the project is a partial clone, made with a filter such as
  # `git clone --filter=blob:none`. A partial clone lacks objects that a commit
  # reaches, so Proof can't send the commit whole.
  class PartialCloneError < Error
    # Builds the error, with a message that says why and what to do next.
    #
    # - `root`: String, the project's root.
    def initialize: (root: String) -> void
  end

  # Raised when the `git` program ends with a status other than 0 and the
  # caller has no better word for why. A refusal Proof can explain, such as a
  # folder outside any repository, has an error class for that refusal.
  class GitFailedError < Error
    # How git ended.
    attr_reader status: Process::Status

    # What git printed to standard error.
    attr_reader error_output: String

    # Builds the error, with a message that gives the command, git's exit
    # status, and what git said.
    #
    # - `subcommand`: String, the git command that failed, such as `"rev-parse"`.
    # - `status`: Process::Status, how git ended.
    # - `error_output`: String, what git printed to standard error.
    def initialize: (subcommand: String, status: Process::Status, error_output: String) -> void
  end
end
