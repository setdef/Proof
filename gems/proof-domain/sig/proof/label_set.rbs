module Proof
  # The labels a runner offers, or the labels a task asks for.
  #
  # The server places a run only on a runner that has every label the task
  # asks for. Compared as arrays, `["gpu", "kvm"]` and `["kvm", "gpu"]` differ,
  # and a repeated label counts twice.
  #
  # A set holds each label once, in no order, so two sets with the same labels
  # are equal. Labels that differ only in case are one label, so `GPU` and
  # `gpu` count once, and the set keeps the first spelling it was given. Ask a
  # runner's set whether it offers every label of a task's set.
  #
  # Use it for a runner's labels and for a task's `label` entries.
  #
  # ## Examples
  #
  # ```ruby
  # runner = Proof::LabelSet.of("desktop", "gpu")
  # runner.offers_every_label_of?(Proof::LabelSet.of("gpu")) # => true
  # runner.offers_every_label_of?(Proof::LabelSet.of("gpu", "kvm")) # => false
  # ```
  #
  # A repeated label and the order make no difference:
  #
  # ```ruby
  # Proof::LabelSet.of("gpu", "kvm", "gpu") == Proof::LabelSet.of("kvm", "gpu") # => true
  # ```
  #
  # So does the case of a label:
  #
  # ```ruby
  # Proof::LabelSet.of("GPU").offers_every_label_of?(Proof::LabelSet.of("gpu")) # => true
  # ```
  class LabelSet < Data
    # The labels, in a frozen set.
    attr_reader labels: Set[Label]

    def self.new: (labels: Array[Label] | Set[Label]) -> instance
                | (Array[Label] | Set[Label] labels) -> instance

    # Builds a set of labels from `names`.
    #
    # - `names`: each a String, as `Proof::Label.new` takes it.
    #
    # ```ruby
    # Proof::LabelSet.of("gpu", "kvm").labels.size # => 2
    # Proof::LabelSet.of.labels.size # => 0
    # ```
    def self.of: (*String names) -> LabelSet

    # Builds a set, and raises `Proof::InvalidLabelSetError` unless `labels`
    # is an `Array` or `Set` of `Proof::Label` values. A set of strings raises,
    # and so does any other collection, even an empty one such as `{}` or
    # `(1..0)`.
    #
    # - `labels`: an `Array` or `Set` of `Proof::Label`.
    def initialize: (labels: Array[Label] | Set[Label]) -> void

    # A new set with the labels of both sets, which are left as they were. A
    # label in both counts once, whatever its case.
    #
    # - `other`: LabelSet, the labels to add.
    #
    # ```ruby
    # (Proof::LabelSet.of("desktop") | Proof::LabelSet.of("gpu")).labels.size # => 2
    # ```
    def |: (LabelSet other) -> LabelSet

    # Whether this set has every label in `required`. An empty `required` is
    # always satisfied.
    #
    # - `required`: LabelSet, the labels a task asks for.
    #
    # ```ruby
    # Proof::LabelSet.of("gpu").offers_every_label_of?(Proof::LabelSet.of) # => true
    # ```
    def offers_every_label_of?: (LabelSet required) -> bool
  end
end
