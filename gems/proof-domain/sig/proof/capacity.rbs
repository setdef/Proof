module Proof
  # Sums and differences of CPUs and memory, never below zero.
  #
  # `Proof::Host` adds up the requests of the runs it holds and takes them
  # from what it has, and a difference below zero would read as room. It is a
  # separate module so the arithmetic is in one place. It is a private
  # constant of `Proof`.
  module Capacity
    # No CPUs and no memory.
    NONE: Resources

    # What is left of `from` after the runs in `runs` and after `kept`, each
    # resource no lower than 0.
    def self.free: (Resources from, Array[Run] runs, ?Resources kept) -> Resources

    # The CPUs and memory the runs in `runs` request, added up.
    def self.sum: (Array[Run] runs) -> Resources

    # `from` less `taken`, each resource no lower than 0.
    def self.less: (Resources from, Resources taken) -> Resources

    # The fewer CPUs and the less memory of `first` and `second`, each on its
    # own.
    def self.least: (Resources first, Resources second) -> Resources

    # The most CPUs and the most memory any of `runners` can use, each on its
    # own, or none.
    def self.most: (Array[Runner] runners) -> Resources

    # The more CPUs and the more memory of `first` and `second`, each on its
    # own.
    def self.more: (Resources first, Resources second) -> Resources

    # Resources whose CPUs are the block's answer for the CPUs of `first` and
    # `second`, and whose memory is its answer for their memory.
    def self.combine: (Resources first, Resources second) { (Integer one, Integer other) -> Integer } -> Resources
  end
end
