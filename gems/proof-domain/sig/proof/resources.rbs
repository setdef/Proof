module Proof
  # The CPUs and memory a task requests.
  #
  # The server places a run only where a host has the resources free, and the
  # runner holds the run to its memory request. A project file writes memory
  # as text, `"512MB"` or `"8GB"`, and the server compares amounts. Left as
  # text, `"1GB"` and `"1024MB"` look like two requests.
  #
  # This class reads a size into whole megabytes. A size is a number, whole or
  # decimal, an optional space, and a unit: `MB`, `GB`, `TB`, `MiB`, `GiB`, or
  # `TiB`, in any case. Every unit counts in 1,024s, so 1 GB is 1,024 MB, and
  # `MB` and `MiB` are one unit. A size that isn't a whole number of megabytes
  # rounds up to the next whole megabyte, so a request is never smaller than
  # what was written.
  #
  # A request raises unless its CPUs are a whole number from 1 and its memory
  # is a size. A host's free amounts and its share can be 0 CPUs and 0
  # megabytes, so resources built from numbers accept a whole number of CPUs
  # from 0. Ask a request whether it fits within what a host has free.
  #
  # Use it for a task's request, a flag's request, and a host's free amounts.
  #
  # ## Examples
  #
  # ```ruby
  # asked = Proof::Resources.request(cpus: 4, memory: "8GB")
  # asked.megabytes # => 8192
  # asked.fits_within?(Proof::Resources.request(cpus: 8, memory: "16GB")) # => true
  # asked.fits_within?(Proof::Resources.request(cpus: 2, memory: "16GB")) # => false
  # ```
  #
  # A size in gigabytes and the same size in megabytes are one request, and so
  # are sizes written with another case, a space, or `GiB`:
  #
  # ```ruby
  # Proof::Resources.request(cpus: 1, memory: "1GB") == Proof::Resources.request(cpus: 1, memory: "1024MB") # => true
  # Proof::Resources.request(cpus: 1, memory: "8 gb") == Proof::Resources.request(cpus: 1, memory: "8GiB") # => true
  # ```
  #
  # A decimal size rounds up to the next whole megabyte:
  #
  # ```ruby
  # Proof::Resources.request(cpus: 1, memory: "1.5GB").megabytes # => 1536
  # Proof::Resources.request(cpus: 1, memory: "0.1GB").megabytes # => 103
  # ```
  #
  # A request needs at least 1 CPU:
  #
  # ```ruby
  # # Wrong: raises Proof::InvalidResourcesError
  # Proof::Resources.request(cpus: 0, memory: "8GB")
  # ```
  #
  # A size needs a unit from the list, and at most one space:
  #
  # ```ruby
  # # Wrong: raises Proof::InvalidResourcesError
  # Proof::Resources.request(cpus: 1, memory: "8G")
  # ```
  #
  # A host with every CPU in use has 0 CPUs free, and nothing asked for fits
  # within it:
  #
  # ```ruby
  # busy = Proof::Resources.new(cpus: 0, megabytes: 4096)
  # Proof::Resources.request(cpus: 1, memory: "1GB").fits_within?(busy) # => false
  # ```
  class Resources < Data
    # The message for a memory that isn't a size, which `format` fills in with
    # what the memory was.
    MEMORY_MESSAGE: String

    # The number of CPUs, a whole number from 0.
    attr_reader cpus: Integer

    # The memory in megabytes, a whole number from 0.
    attr_reader megabytes: Integer

    def self.new: (cpus: Integer, megabytes: Integer) -> instance
                | (Integer cpus, Integer megabytes) -> instance

    # Builds a request from CPUs and a memory size as a project file writes it.
    # It raises `Proof::InvalidResourcesError` unless `cpus` is an Integer from
    # 1, as a task's `cpus` is, and `memory` is a number, whole or decimal with
    # digits on both sides of the point, none or one space, and `MB`, `GB`, `TB`,
    # `MiB`, `GiB`, or `TiB` in any case, such as `"512MB"`, `"8 gb"`,
    # `"1.5GiB"`, or `"0GB"`. A decimal size rounds up to the next whole
    # megabyte. A number, `nil`, `"8"`, `"8G"`, `"1e3MB"`, `"-1GB"`, `".5GB"`,
    # `"8  GB"`, `"8GB "`, a string with a byte that isn't valid text, and a
    # string in an encoding that isn't ASCII-compatible, such as UTF-16, raise
    # as memory, and `0` raises as `cpus`. The message lists the forms that
    # work.
    #
    # - `cpus`: Integer, a whole number from 1.
    # - `memory`: String, such as `"4GB"`.
    #
    # ```ruby
    # Proof::Resources.request(cpus: 2, memory: "512MB").megabytes # => 512
    # Proof::Resources.request(cpus: 2, memory: "1.5 tib").megabytes # => 1_572_864
    # ```
    def self.request: (cpus: Integer, memory: String) -> Resources

    # Builds resources from CPUs and megabytes, and raises
    # `Proof::InvalidResourcesError` unless `cpus` and `megabytes` are each an
    # Integer from 0. Zero CPUs and zero megabytes are a host with nothing free,
    # or a share that keeps nothing.
    #
    # - `cpus`: Integer, a whole number from 0.
    # - `megabytes`: Integer, a whole number from 0.
    #
    # ```ruby
    # Proof::Resources.new(cpus: 0, megabytes: 0).cpus # => 0
    # ```
    def initialize: (cpus: Integer, megabytes: Integer) -> void

    # Whether these resources fit within `available`: no more CPUs and no
    # more memory than it has. Equal amounts fit.
    #
    # - `available`: Resources, what a host has free.
    #
    # ```ruby
    # asked = Proof::Resources.request(cpus: 2, memory: "4GB")
    # asked.fits_within?(Proof::Resources.request(cpus: 2, memory: "4GB")) # => true
    # asked.fits_within?(Proof::Resources.request(cpus: 2, memory: "3GB")) # => false
    # ```
    def fits_within?: (Resources available) -> bool
  end
end
