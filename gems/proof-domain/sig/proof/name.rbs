module Proof
  # The rule for the name of a host, a runner, a repository, a branch, or a
  # task: text with at least one character that isn't white space.
  #
  # A pool file or a project file can hold `host ""` or `task "  "`, and KDL
  # accepts both. A host with a blank name would show in `proof status` under a
  # name nobody can type, a blank branch would watch nothing, and a blank task
  # would run nothing. Every value that holds a name refuses one, so a blank
  # name can't exist.
  #
  # This module holds the rule and the message, so the values that hold a name
  # and the readers of the pool file and the project file get both from one
  # place. A reader asks for a name with `read`, which names whose name it is
  # and gives a name that works, so the message tells the person what to write.
  #
  # It holds the rule for comparing names too: the names of hosts, runners, and
  # repositories are one name when they differ only in case, so `nuc` and `NUC`
  # are the same host. A value that holds names and a reader of the pool file
  # compare them with `same?`, so no two places write the rule. A value that
  # holds a list of names asks `list?` or `distinct_list?` whether the list is one,
  # and a pool file's readers and the domain ask `first_repeat` which name in a
  # list repeats an earlier one.
  #
  # Use it from a value that holds a name, and from a reader that refuses a
  # blank name at its own line.
  #
  # ## Examples
  #
  # A name written with a space in the middle is a name:
  #
  # ```ruby
  # Proof::Name.valid?("my host") # => true
  # ```
  #
  # A name of only spaces or tabs is not:
  #
  # ```ruby
  # Proof::Name.valid?("  ") # => false
  # Proof::Name.valid?("\t") # => false
  # ```
  #
  # Two names that differ only in case are one name:
  #
  # ```ruby
  # Proof::Name.same?("nuc", "NUC") # => true
  # Proof::Name.same?("nuc", "nuc-linux") # => false
  # ```
  #
  # A blank name is refused, and the message says what a name is and gives one
  # that works:
  #
  # ```ruby
  # # Wrong: raises Proof::InvalidNameError
  # Proof::Name.read(" ", what: "a host's name", example: "nuc")
  # ```
  module Name
    # What a name is, for a message: text with at least one character that
    # isn't white space.
    TEXT: String

    # The rule for a blank name: no character that isn't white space.
    BLANK: Regexp

    # Whether `value` is a name: a String, with valid text in an encoding that
    # is ASCII-compatible, that has at least one character that isn't white
    # space. White space is what Ruby's `[[:space:]]` matches, so a tab and a
    # no-break space are white space too. A value that isn't a String, text
    # with a byte that isn't valid, and text in an encoding that isn't
    # ASCII-compatible, such as UTF-16, are not names.
    #
    # - `value`: Object, any value.
    #
    # ```ruby
    # Proof::Name.valid?("nuc") # => true
    # Proof::Name.valid?("") # => false
    # Proof::Name.valid?(:nuc) # => false
    # ```
    def self.valid?: (Object? value) -> bool

    # Whether `value` is an `Array` of one or more names, with no name twice as
    # written, so `["nuc", "NUC"]` is a list and `["nuc", "nuc"]` isn't. A value
    # that isn't an `Array`, an empty `Array`, and an `Array` with a member that
    # isn't a name are not lists. Use `distinct_list?` for names that must differ
    # without regard to case.
    #
    # - `value`: Object, any value.
    #
    # ```ruby
    # Proof::Name.list?(["trunk", "main"]) # => true
    # Proof::Name.list?(["trunk", "trunk"]) # => false
    # Proof::Name.list?([]) # => false
    # Proof::Name.list?("trunk") # => false
    # ```
    def self.list?: (Object? value) -> bool

    # Whether `value` is an `Array` of one or more names, no two of which are
    # one name as `same?` finds, so `["nuc-linux", "NUC-LINUX"]` isn't a
    # distinct list. Whatever isn't a `list?` isn't one either.
    #
    # - `value`: Object, any value.
    #
    # ```ruby
    # Proof::Name.distinct_list?(["nuc-linux", "nuc-windows"]) # => true
    # Proof::Name.distinct_list?(["nuc-linux", "NUC-LINUX"]) # => false
    # Proof::Name.distinct_list?([]) # => false
    # ```
    def self.distinct_list?: (Object? value) -> bool

    # The message for a value that isn't a name, with one `%p` for `format` to
    # fill in with the value.
    #
    # - `what`: String, whose name it is, such as `"a host's name"`.
    # - `example`: String, a name that works for it, such as `"nuc"`.
    #
    # ```ruby
    # Proof::Name.message("a host's name", "nuc") # => "a host's name is text with at least one character that isn't white space, such as nuc, not %p"
    # ```
    def self.message: (String what, String example) -> String

    # Whether two names are one name: they are the same text, or differ only in
    # case. It compares with `String#casecmp?`, which folds the case of letters
    # beyond ASCII, so `"Ünal"` and `"ünal"` are one name. A label has a rule of
    # its own, which `Proof::Label` holds, and a branch or a task name compares
    # as written, so this is for the names of hosts, runners, and repositories.
    #
    # - `one`, `other`: String, each a name.
    #
    # ```ruby
    # Proof::Name.same?("nuc", "NUC") # => true
    # Proof::Name.same?("Ünal", "ünal") # => true
    # Proof::Name.same?("nuc", "pc") # => false
    # ```
    def self.same?: (String one, String other) -> bool

    # Where the first name that repeats an earlier name is in `names`, and where
    # the earlier name is: the positions of the two, earlier first, or `nil`
    # when no name repeats an earlier one. The first repeat is the one whose
    # later name comes first in the list, and its earlier name is the first
    # name it repeats. Two names that are text repeat each other as `same?`
    # finds, so `"nuc"` and `"NUC"` do. A value that isn't text, which the
    # domain refuses elsewhere with its own message, repeats only an equal
    # value, so `5` and `"5"` don't.
    #
    # - `names`: Array of names in the order a file gives them. A value that
    #   isn't a name is compared as it is, never refused here.
    #
    # ```ruby
    # Proof::Name.first_repeat(["nuc", "pc", "NUC"]) # => [0, 2]
    # Proof::Name.first_repeat(["nuc", "pc", "mac", "PC", "NUC"]) # => [1, 3]
    # Proof::Name.first_repeat(["nuc", "pc"]) # => nil
    # Proof::Name.first_repeat(["5", 5]) # => nil
    # ```
    def self.first_repeat: (Array[Object?] names) -> [Integer, Integer]?

    private def self.earlier_repeat: (Array[Object?] names, Integer later) -> Integer?

    private def self.repeat?: (Object? one, Object? other) -> bool

    # A frozen copy of `value`, and raises `Proof::InvalidNameError` unless
    # `value` is a name. The message says whose name it is, what a name is, and
    # gives one that works.
    #
    # - `value`: Object, what a file wrote.
    # - `what`: String, whose name it is, such as `"a host's name"`.
    # - `example`: String, a name that works for it, such as `"nuc"`.
    #
    # ```ruby
    # Proof::Name.read("nuc", what: "a host's name", example: "nuc") # => "nuc"
    # ```
    def self.read: (Object value, what: String, example: String) -> String
  end
end
