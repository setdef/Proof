module Proof
  # Checks of the members a value is built from, against a table of rules.
  #
  # `Proof::Host` and `Proof::Runner` each check four or five members, and a
  # line of code for each would make their constructors hard to read. It is a
  # private constant of `Proof`.
  module MemberCheck
    # A rule for one member: whether its value keeps the rule.
    interface _Rule
      # Whether `value` keeps the rule.
      def call: (Object? value) -> bool
    end

    # What checks a member: an object that answers `call`, such as a
    # `Method`, or a lambda.
    type rule = _Rule | ^(Object? value) -> bool

    # The message for the first member in `members` that breaks its rule in
    # `rules`, filled in by `format` with its value, or `nil`.
    #
    # - `rules`: a `Hash` from member to its message and its rule.
    # - `members`: a `Hash` from member to its value.
    def self.problem: (Hash[Symbol, [String, rule]] rules, Hash[Symbol, Object?] members) -> String?

    # Whether `value` is a name, as `Proof::Name` says.
    def self.named?: (Object? value) -> bool

    # Whether `value` is an `Array` of one or more names, as `Proof::Name`
    # says, with no name twice.
    def self.names?: (Object? value) -> bool

    # Whether `value` is an `Array` of one or more names, as `Proof::Name`
    # says, with no two that `Proof::Name.same?` finds to be one name.
    def self.distinct_names?: (Object? value) -> bool

    # Whether `value` is an Integer of at least `minimum`.
    #
    # - `value`: the value to check.
    # - `minimum`: Integer, the least it may be.
    def self.whole?: (Object? value, Integer minimum) -> bool

    # Whether `value` is `true` or `false`.
    def self.flag?: (Object? value) -> bool
  end
end
