{
  "reasons": {
    "stricter-rules": "The gem refuses a value given with `=` to a flag that takes none, and a value that looks like a flag after `=`, where usage binds them (issue #162).",
    "unknown-flags-default": "The corpus's specs leave `unknown_flags` unset, and usage's default is `value`, which binds a word that looks like a flag and names none to an argument. The gem reads a missing key as `error` and refuses the word (issue #158).",
    "docs-and-program": "The corpus follows usage's documentation of the grammar, where `-j8` and `-j=8` bind to `-j`. usage's program reads the letter after a flag that takes a value as a flag of its own, so it refuses them, and the gem follows the program (issue #124)."
  },
  "differences": {
    "long-boolean-with-empty-attached-value": "stricter-rules",
    "long-boolean-with-attached-value": "stricter-rules",
    "long-value-attached-flaglike": "stricter-rules",
    "long-unknown": "unknown-flags-default",
    "long-many-dashes-names-nothing": "unknown-flags-default",
