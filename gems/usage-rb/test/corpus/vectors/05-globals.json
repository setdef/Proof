    {
      "id": "global-with-value-after-subcommand",
      "doc": "A global flag that takes a value binds it the same way at any depth.",
      "spec": "name \"ex\"\nbin \"ex\"\nflag \"-C --cd <dir>\" global=#true\ncmd \"install\"\n",
      "argv": [
        "install",
        "-C",
        "/tmp"
      ],
      "expect": {
