{
  "section": "default-subcommand-on-empty",
  "about": "Opt-in routing selects the declared default command only when the root reaches the successful end of argv without consuming a positional argument or a syntactic separator.",
  "vectors": [
    {
      "id": "empty-selects-default",
      "doc": "An explicitly enabled empty invocation enters the default command.",
      "spec": "name \"ex\"\nbin \"ex\"\ndefault_subcommand \"run\"\ndefault_subcommand_on_empty #true\ncmd \"run\"\n",
      "argv": [],
      "expect": {
        "ok": {
          "cmd": [
            "run"
          ]
        }
      },
      "spec_json": {
