    {
      "id": "arg-interleaved-with-flags",
      "doc": "Flags and positionals may interleave; a flag between two words does not change which argument each word fills.",
      "spec": "name \"ex\"\nbin \"ex\"\nflag \"-f --force\"\narg \"<src>\"\narg \"<dst>\"\n",
      "argv": [
        "from",
        "-f",
        "to"
      ],
      "expect": {
        "ok": {
          "flags": {
            "force": true
          },
          "args": {
            "src": "from",
            "dst": "to"
          }
        }
      },
