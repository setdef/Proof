module Usage
  # A program's commands, as a tree under the program, and each command where it stands in it.
  #
  # A command is named by the words of its path, such as `remote add`, and some of usage's rules apply to a command
  # because of the commands above it: a flag that a command marks global applies to every command under it. A command
  # alone holds its subcommands, not the commands above it.
  #
  # This class finds the command that a path names, and gives its `Usage::Lineage`, which answers each of those rules
  # for it. The parser and the help ask it too, so all of them follow one reading of each rule.
  #
  # Use it to look a command up by its path, and to learn what applies to it there.
  #
  # ## Examples
  #
  # ```ruby
  # require "usage"
  # spec = Usage::Spec.read(<<~JSON)
  #   {"cmd": {"flags": [{"name": "quiet", "long": ["quiet"], "global": true}],
  #            "subcommands": {"remote": {"name": "remote", "full_cmd": ["remote"],
  #              "flags": [{"name": "dry-run", "long": ["dry-run"], "global": true}],
  #              "subcommands": {"add": {"name": "add", "full_cmd": ["remote", "add"]}}}}}}
  # JSON
  # tree = spec.commands
  # tree.find(["remote", "add"])&.name # => "add"
  # tree.at(["remote", "add"]).global_flags.map(&:name) # => ["quiet", "dry-run"]
  # tree.at([]).global_flags.map(&:name) # => ["quiet"]
  # ```
  class CommandTree < Data
    # The program itself, as a command with no path, whose subcommands are the program's commands.
    attr_reader root: Command

    def self.new: (root: Command) -> instance
                | (Command root) -> instance

    # Builds the tree under `root`.
    #
    # - `root`: `Usage::Command`, the program as a command.
    def initialize: (root: Command) -> void

    # The lineage of the command that the words in `path` name: that command where it stands, with every command above
    # it. An empty `path` stands at the program. Raises `KeyError` when no command has that path; `find` answers
    # whether one does.
    #
    # - `path`: Array of String, such as `["remote", "add"]`.
    #
    # ```ruby
    # tree.at(["remote"]).commands.map(&:name) # => ["", "remote"]
    # ```
    def at: (Array[String] path) -> Lineage

    # The command that the words in `path` name, or `nil` when no command has that path. An empty `path` names the
    # program itself.
    #
    # - `path`: Array of String, such as `["remote", "add"]`.
    #
    # ```ruby
    # tree.find([]) == tree.root # => true
    # tree.find(["remote", "rm"]) # => nil
    # ```
    def find: (Array[String] path) -> Command?

    private

    # The lineage of the program itself, where every path starts.
    def program: () -> Lineage
  end
end
