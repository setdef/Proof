module Usage
  # Reads one object of the spec's JSON with the type each key has, and refuses any key the gem doesn't act on.
  class Reader
    # The format of one kind of part of the spec, which reads the part from its object, given where the object above
    # it is.
    interface _Part[T]
      # Reads the part from `object`, its object in the spec's JSON, where `parent` is the place of the object above
      # it, such as `"command add"`, for the messages of errors.
      def read: (object object, Place parent) -> T
    end

    @object: object
    @place: Place

    # Takes the object, where it is in the spec for the messages of errors, and the keys the gem accepts there, and
    # raises `Usage::SpecError` for any other key or value. A key whose value is `null` reads as left out.
    def initialize: (object object, Place place, keys keys) -> void

    # Raises `Usage::SpecError` saying the part this object holds does `what`, which the gem doesn't support.
    def unsupported: (String what) -> bot

    # The String under `key`, or `nil` when it is left out.
    def text: (Symbol key) -> String?

    # The Strings in the list under `key`, or an empty list when it is left out.
    def texts: (Symbol key) -> Array[String]

    # The `true` or `false` under `key`, or `false` when it is left out.
    def boolean: (Symbol key) -> bool

    # Whether `key` holds `false`, which a key left out doesn't. The keys the gem accepts say which values the key
    # may have.
    def false?: (Symbol key) -> bool

    # The whole number under `key`.
    def number: (Symbol key) -> Integer

    # The object under `key`, or an empty one when it is left out.
    def object: (Symbol key) -> object

    # A reader of the object under `key`, with the keys the gem accepts there, or `nil` when it is left out.
    def nested: (Symbol key, keys keys) -> Reader?

    # Each object in the list under `key` read as a part of the spec by `kind`, its format, which is told where this
    # object is, or an empty list when the key is left out.
    def parts: [T] (Symbol key, _Part[T] kind) -> Array[T]

    # The objects among the values of the object under `key`, in order, or an empty list when it is left out.
    def members: (Symbol key) -> Array[object]

    private

    def list: (Symbol key) -> Array[json]
  end
end
