module Usage
  # A program's command-line interface, read from the JSON of its usage spec.
  #
  # usage keeps a spec in KDL, and `usage generate json` writes it as JSON with the defaults filled in. Ruby reads
  # that JSON as hashes of no known shape, so every reader of it would check each key's type again, and a key it
  # missed would change nothing it does.
  #
  # This class holds the program's interface as typed values: the program, its commands, and each command's flags
  # and arguments. It reads the JSON once, and raises `Usage::SpecError` for a text that isn't such JSON, for a key of
  # the wrong type, and for anything the gem doesn't act on, so a spec it reads means what it says. A key the JSON
  # leaves out takes usage's default.
  #
  # Use it to reach a program's commands, its examples, and its exit statuses.
  #
  # ## Examples
  #
  # ```ruby
  # require "usage"
  # spec = Usage::Spec.read(<<~JSON)
  #   {"bin": "todo", "about": "Keep a list of things to do",
  #    "exit_codes": [{"code": 0, "help": "It worked."}],
  #    "cmd": {"subcommands": {"list": {"name": "list", "full_cmd": ["list"], "help": "List the items"}}}}
  # JSON
  # spec.bin # => "todo"
  # spec.commands.find(["list"])&.help # => "List the items"
  # spec.commands.find(["lsit"]) # => nil
  # ```
  #
  # A spec that uses something the gem doesn't act on is refused when it is read:
  #
  # ```ruby
  # # Wrong: raises Usage::SpecError
  # Usage::Spec.read('{"cmd": {"subcommands": {"list": {"name": "list", "aliases": ["ls"]}}}}')
  # ```
  class Spec < Data
    # The program's name as typed, such as `"todo"`, or an empty String when the spec has none.
    attr_reader bin: String

    # The one-line description of the program, or an empty String.
    attr_reader about: String

    # The longer description, or `nil`.
    attr_reader about_long: String?

    # The text for the end of the program's help, from `after_long_help`, or `nil`.
    attr_reader after_help: String?

    # The program's examples, in the spec's order.
    attr_reader examples: Array[Example]

    # The program's commands, as a tree under the program itself.
    attr_reader commands: CommandTree

    # The prefix of the environment variables the program refuses when it doesn't know them, or `nil`.
    attr_reader env_prefix: String?

    # The variables with that prefix the program accepts anyway.
    attr_reader env_allowed: Array[String]

    def self.new: (bin: String, about: String, about_long: String?, after_help: String?, examples: Array[Example], commands: CommandTree, env_prefix: String?, env_allowed: Array[String]) -> instance
                | (String bin, String about, String? about_long, String? after_help, Array[Example] examples, CommandTree commands, String? env_prefix, Array[String] env_allowed) -> instance

    # Builds a spec from its parts.
    #
    # - `bin`: String, the program's name as typed.
    # - `about`: String, the one-line description.
    # - `about_long`: String or `nil`, the longer description.
    # - `after_help`: String or `nil`, the text for the end of the help.
    # - `examples`: Array of `Usage::Example`, the program's examples.
    # - `commands`: `Usage::CommandTree`, the program's commands.
    # - `env_prefix`: String or `nil`, the prefix of the variables to check.
    # - `env_allowed`: Array of String, the variables with the prefix to accept.
    def initialize: (bin: String, about: String, about_long: String?, after_help: String?, examples: Array[Example], commands: CommandTree, env_prefix: String?, env_allowed: Array[String]) -> void

    # Reads a spec from `text`, the JSON `usage generate json` writes, and raises `Usage::SpecError` for a text that
    # isn't such JSON or that uses anything the gem doesn't act on.
    #
    # - `text`: String, the JSON document.
    #
    # ```ruby
    # Usage::Spec.read("{}").commands.root.subcommands # => []
    # Usage::Spec.read('{"bin": "todo"}').about # => ""
    # ```
    def self.read: (String text) -> Spec

    # The statuses the spec declares for the whole program, in its order, which are the program command's. They apply
    # to every command, and `Usage::Lineage#exit_codes` gives those that apply to one command.
    #
    # ```ruby
    # spec.exit_codes.map(&:status) # => [0]
    # ```
    def exit_codes: () -> Array[ExitCode]
  end
end
