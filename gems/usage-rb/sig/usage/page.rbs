module Usage
  # One page of help: the sections every help has, in order. Each kind of page, the program's or a command's, gives
  # the texts that open it, its examples, the title of its table of commands, and the sections that end it.
  class Page
    @spec: Spec
    @lineage: Lineage

    # The widest line of the title and the descriptions.
    WIDTH: Integer

    # Takes the spec and the lineage of the command whose help to write.
    def initialize: (Spec spec, Lineage lineage) -> void

    # Each section of the help, or `nil` for one with nothing in it.
    def sections: () -> Array[String?]

    private

    attr_reader spec: Spec

    attr_reader lineage: Lineage

    def command: () -> Command

    def title: () -> String?

    def tables: () -> Array[String?]

    def words: () -> Array[String]

    # The one-line description after the title.
    def about: () -> String

    # The longer description under the title, or `nil`.
    def description: () -> String?

    # The examples after the usage line.
    def examples: () -> Array[Example]

    # The title of the table of the command's subcommands. The program's subcommands are its commands.
    def commands_title: () -> String

    # The sections after the tables, each `nil` when it has nothing in it.
    def ending: () -> Array[String?]
  end
end
