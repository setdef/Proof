module Usage
  # Where the reading of a command line stands: the lineage of the command its words have reached, with the messages
  # that word a mistake made there.
  class Position < Data
    # The command the words have reached, where it stands in its tree.
    attr_reader lineage: Lineage

    # The class of the messages that word a mistake.
    attr_reader messages: singleton(Messages)

    def self.new: (lineage: Lineage, messages: singleton(Messages)) -> instance
                | (Lineage lineage, singleton(Messages) messages) -> instance

    # Stands at the command of `lineage`.
    def initialize: (lineage: Lineage, messages: singleton(Messages)) -> void

    # A copy with the members given changed.
    def with: (?lineage: Lineage, ?messages: singleton(Messages)) -> Position

    # The command the words have reached.
    def command: () -> Command

    # The flags the command takes here: its own, then the global flags in effect at it.
    def flags: () -> Array[Flag]

    # The flags the command takes here, by switch.
    def scope: () -> Scope

    # Whether the command has subcommands, so a word before `--` names one.
    def branch?: () -> bool

    # The position at the subcommand that `word` names, or a mistake when it names none.
    def descend: (String word) -> Position

    # Raises `Usage::CommandLineError` at the command, with the message the block words with the messages here.
    def refuse: () { (Messages said) -> String } -> bot
  end
end
