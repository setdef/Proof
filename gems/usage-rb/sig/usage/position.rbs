module Usage
  # Where the reading of a command line stands: the command its words have reached, in its tree, with the messages
  # that word a mistake made there.
  class Position < Data
    # The program's commands.
    attr_reader commands: CommandTree

    # The command the words have reached.
    attr_reader command: Command

    # The class of the messages that word a mistake.
    attr_reader messages: _MessagesClass

    def self.new: (commands: CommandTree, command: Command, messages: _MessagesClass) -> instance
                | (CommandTree commands, Command command, _MessagesClass messages) -> instance

    # Stands at `command`.
    def initialize: (commands: CommandTree, command: Command, messages: _MessagesClass) -> void

    # A copy with the members given changed.
    def with: (?commands: CommandTree, ?command: Command, ?messages: _MessagesClass) -> Position

    # The flags the command takes here: its own, then the global flags of the commands on its path.
    def flags: () -> Array[Flag]

    # The flags the command takes here, by switch.
    def scope: () -> Scope

    # Whether the command has subcommands, so a word before `--` names one.
    def branch?: () -> bool

    # The position at the subcommand that `word` names, or a mistake when it names none.
    def descend: (String word) -> Position

    # Raises `Usage::CommandLineError` at the command, with the message the block words with the messages here.
    def refuse: () { (_Messages said) -> String } -> bot
  end
end
