module Usage
  # Writes each list of the help that holds parts of the spec: the examples, and the tables of commands, arguments,
  # flags, and exit statuses. Each is `nil` when it has nothing in it.
  module Rows
    # The widest line of an example's explanation.
    EXAMPLE_WIDTH: Integer

    # The examples under their title.
    def self.examples: (Array[Example] list) -> String?

    # A table of commands under `title`, each with its name and its one-line description.
    def self.commands: (String title, Array[Command] list) -> String?

    # The table of a command's arguments, each as the usage line writes it, with its one-line description.
    def self.arguments: (Array[Arg] list) -> String?

    # A table of flags under `title`, each with its switches, its value, its description, and its choices.
    def self.flags: (String title, Array[Flag] list) -> String?

    # The table of the program's exit statuses.
    def self.exit_statuses: (Array[ExitCode] codes) -> String?

    private def self.example_lines: (Example example) -> Array[String]

    private def self.label: (Flag flag) -> String

    private def self.text: (Flag flag) -> String
  end
end
