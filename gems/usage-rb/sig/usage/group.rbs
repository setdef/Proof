module Usage
  # A set of flags and arguments of which a command takes one, or at least one.
  #
  # A command can take an item's text or a file of items, and needs one of the two. Left to each flag's own rules,
  # nothing would see that both are missing, or that both were given.
  #
  # This class names the members of such a set, says whether one is required, and says whether more than one may
  # come together.
  #
  # Use it to list the members a command line has to give.
  #
  # ## Examples
  #
  # ```ruby
  # require "usage"
  # spec = Usage::Spec.read(<<~JSON)
  #   {"cmd": {"groups": [{"name": "source", "members": ["text", "--file"], "required": true}]}}
  # JSON
  # source = spec.commands.root.groups.first || raise
  # source.names # => ["text", "--file"]
  # [source.required?, source.multiple?] # => [true, false]
  # ```
  class Group < Data
    # The group's name in the spec.
    attr_reader name: String

    # The members: an argument by its name, or a flag by a switch, such as `"text"` and `"--file"`.
    attr_reader names: Array[String]

    # Whether a member must be given.
    attr_reader required: bool

    # Whether more than one member may be given together.
    attr_reader multiple: bool

    def self.new: (name: String, names: Array[String], required: bool, multiple: bool) -> instance
                | (String name, Array[String] names, bool required, bool multiple) -> instance

    # Builds a group from its parts.
    #
    # - `name`: String, the group's name.
    # - `names`: Array of String, the members.
    # - `required`: bool, whether a member must be given.
    # - `multiple`: bool, whether more than one may come together.
    def initialize: (name: String, names: Array[String], required: bool, multiple: bool) -> void

    # Whether a member must be given.
    #
    # ```ruby
    # source.required? # => true
    # ```
    def required?: () -> bool

    # Whether more than one member may be given together.
    #
    # ```ruby
    # source.multiple? # => false
    # ```
    def multiple?: () -> bool
  end
end
