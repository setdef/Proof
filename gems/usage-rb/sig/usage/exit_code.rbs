module Usage
  # A status the program exits with, and what it means.
  #
  # Scripts read a program's exit status, so each status has to mean one thing, and the help lists them.
  #
  # This class holds one status and its meaning.
  #
  # Use it to print the exit statuses in the program's help.
  #
  # ## Examples
  #
  # ```ruby
  # require "usage"
  # spec = Usage::Spec.read('{"exit_codes": [{"code": 2, "help": "The command line has a mistake."}]}')
  # code = spec.exit_codes.first || raise
  # [code.status, code.help] # => [2, "The command line has a mistake."]
  # ```
  class ExitCode < Data
    # The exit status, such as `2`.
    attr_reader status: Integer

    # What the status means, or an empty String.
    attr_reader help: String

    def self.new: (status: Integer, help: String) -> instance
                | (Integer status, String help) -> instance

    # Builds an exit status from its parts.
    #
    # - `status`: Integer, the status.
    # - `help`: String, what it means.
    def initialize: (status: Integer, help: String) -> void
  end
end
