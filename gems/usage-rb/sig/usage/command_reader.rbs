module Usage
  # Reads a command, and every command under it, from the spec's JSON.
  module CommandReader
    # The keys of a command's object that the gem accepts. It accepts `effect`, which says what the command does to
    # the world for tools that act for a person, and reads nothing of it. Aliases, mounts, headings, and hidden
    # commands aren't supported, nor is any `unknown_flags` but `"error"`.
    KEYS: keys

    # Reads a command, and every command under it, from its object in the spec's JSON, and raises
    # `Usage::SpecError` when one has both arguments and subcommands.
    #
    # - `object`: Hash, the command's object.
    #
    # ```ruby
    # Usage::Spec.read('{"cmd": {"subcommands": {"list": {"name": "list", "full_cmd": ["list"]}}}}').root.subcommands.first&.path # => ["list"]
    # ```
    def self.read: (object object) -> Command

    private def self.place: (json words) -> String

    private def self.described: (Reader reader) -> { name: String, path: Array[String] }

    private def self.words: (Reader reader, String where) -> { args: Array[Arg], subcommands: Array[Command], subcommand_required: bool }

    private def self.parts: (Reader reader, String where) -> { flags: Array[Flag], groups: Array[Group], examples: Array[Example] }
  end
end
