module Usage
  # How the spec's JSON writes a flag, its value, and its choices, read into a `Usage::Flag`.
  module FlagFormat
    # The keys of a flag's object that the gem accepts. A hidden flag isn't supported.
    KEYS: keys

    # The keys of the object that describes a flag's value. A value that may be left out, or one with other rules for
    # `--`, isn't supported.
    VALUE_KEYS: keys

    # The keys of the object that lists a value's choices. `strict` is `true` or `false`.
    CHOICE_KEYS: keys

    # Reads a flag from `object`, one entry of a command's `flags`, where `parent` is the place of its command, such as
    # `"command add"`, and raises `Usage::SpecError` for anything the gem doesn't act on, such as a count, a default,
    # or a value that may be left out.
    def self.read: (object object, Place parent) -> Flag

    private def self.valued: (Reader reader) -> { value: String?, choices: Choices, repeatable: bool }
  end
end
