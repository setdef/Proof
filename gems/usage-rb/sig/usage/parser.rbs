module Usage
  # Reads a command line by the rules of usage, against a spec.
  #
  # A program that reads its spec for help still has to read its command line, and a parser written for another
  # library's rules reads some lines otherwise than usage does: it takes the front of a flag's name for the flag, or
  # `-Cdir` for `-C dir`, so the program accepts what its own spec refuses.
  #
  # This class reads the words of a command line by usage's rules: the command they name, each flag with its value,
  # and the words of each argument. It refuses a mistake with `Usage::CommandLineError`, worded by the messages it is
  # given, and stops at `-h` or `--help`. It reads by usage 7.4.1's rules unless it is given `value_rules: Usage::StrictValueRules`.
  #
  # Use it to read a program's command line by the spec its help and its reference come from.
  #
  # ## Examples
  #
  # ```ruby
  # require "usage"
  # spec = Usage::Spec.read(<<~JSON)
  #   {"bin": "todo",
  #    "cmd": {"flags": [{"name": "quiet", "short": ["q"], "long": ["quiet"], "global": true}],
  #            "subcommands": {"add": {"name": "add", "full_cmd": ["add"],
  #              "args": [{"name": "text", "required": true}],
  #              "flags": [{"name": "tag", "long": ["tag"], "var": true, "arg": {"name": "tag"}}]}}}}
  # JSON
  # parsed = Usage::Parser.new(spec).parse(["add", "Buy milk", "--tag", "home", "-q"])
  # parsed.command.path # => ["add"]
  # parsed.words("text") # => ["Buy milk"]
  # [parsed.values("tag"), parsed.given?("quiet")] # => [["home"], true]
  # ```
  #
  # A mistake raises `Usage::CommandLineError`:
  #
  # ```ruby
  # begin
  #   Usage::Parser.new(spec).parse(["add"])
  # rescue Usage::CommandLineError => e
  #   e.message # => "command add needs <text>"
  # end
  # ```
  class Parser
    MESSAGES_REFUSED: String

    @commands: CommandTree
    @messages: singleton(Messages)
    @rules: _ValueRules

    # Prepares to read command lines against `spec`.
    #
    # - `spec`: `Usage::Spec`, the program's spec.
    # - `messages`: `Usage::Messages`, or a subclass of it, whose instances word the mistakes made at a command. A
    #   program words mistakes its own way with a subclass, which keeps the gem's words for each kind of mistake that
    #   it doesn't word, including a kind the gem learns later. Any other class raises `ArgumentError`.
    # - `value_rules`: `Usage::UsageValueRules` unless given, which reads a value as usage 7.4.1 does. Give
    #   `Usage::StrictValueRules` to read by two rules stricter than usage's, so that nothing typed is dropped and every
    #   value meets one rule. A value given with `=` to a flag that takes none, such as `--json=1`, is then a mistake,
    #   where usage drops it. A value that looks like a flag is then a mistake after `=` too, and so is a negative
    #   number, after `=` or after the flag, where usage takes `--file=-x`, and takes `-5` as the value that a flag
    #   requires. Any object that answers `Usage::_ValueRules` may be given.
    #
    # ```ruby
    # words = ["add", "x", "--tag=-q"]
    # Usage::Parser.new(spec).parse(words).value("tag") # => "-q"
    # begin
    #   Usage::Parser.new(spec, value_rules: Usage::StrictValueRules).parse(words)
    # rescue Usage::CommandLineError => e
    #   e.message # => "--tag of command add needs a value, and -q looks like a flag"
    # end
    # ```
    def initialize: (Spec spec, ?messages: singleton(Messages), ?value_rules: _ValueRules) -> void

    # What `words`, the words after the program's name, give: the command, its flags, and its arguments, or that
    # they ask for help. Raises `Usage::CommandLineError` for a mistake, the first one in the words.
    #
    # - `words`: Array of String, as the shell gives them.
    #
    # ```ruby
    # Usage::Parser.new(spec).parse(["-h", "add"]).help? # => true
    # ```
    def parse: (Array[String] words) -> Parsed
  end
end
