module Usage
  # How the spec's JSON writes an argument, read into a `Usage::Arg`.
  module ArgFormat
    # The keys of an argument's object that the gem accepts. A hidden argument, or one with other rules for `--`,
    # isn't supported.
    KEYS: Keys

    # Reads an argument from `object`, one entry of a command's `args`, where `parent` is the place of its command,
    # such as `"command add"`, and raises `Usage::SpecError` for anything the gem doesn't act on.
    def self.read: (object object, Place parent) -> Arg
  end
end
