module Usage
  # One flag of a command, as the spec describes it.
  #
  # The parser and the help both ask what a flag is called, whether it takes a value, which values it accepts, and
  # what it needs beside it. Asked of the JSON each time, the answers would differ wherever a key is left out.
  #
  # This class holds those answers, each as the spec gives it or as usage's default.
  #
  # Use it to list a command's switches and to check a value against a flag's choices.
  #
  # ## Examples
  #
  # ```ruby
  # require "usage"
  # spec = Usage::Spec.read(<<~JSON)
  #   {"cmd": {"flags": [
  #     {"name": "due", "short": ["d"], "long": ["due"], "arg": {"name": "date"}},
  #     {"name": "tag", "long": ["tag"], "var": true,
  #      "arg": {"name": "tag", "choices": {"choices": ["home", "work"], "strict": false}}},
  #     {"name": "sort", "long": ["sort"], "arg": {"name": "key", "choices": {"choices": ["due", "added"]}}}]}}
  # JSON
  # due, tag, sort = spec.commands.root.flags
  # due.switches # => ["-d", "--due"]
  # due.value # => "date"
  # due.takes_value? # => true
  # ```
  #
  # A flag can limit its value to choices, and accept others when the choices aren't strict:
  #
  # ```ruby
  # [tag.choices.values, tag.choices.strict?, tag.repeatable?] # => [["home", "work"], false, true]
  # ```
  class Flag < Data
    # The flag's name in the spec, such as `"dry-run"`.
    attr_reader name: String

    # The one-letter names, without the hyphen, such as `["n"]`.
    attr_reader short: Array[String]

    # The long names, without the hyphens, such as `["dry-run"]`.
    attr_reader long: Array[String]

    # The name of the value the flag takes, such as `"date"`, or `nil` for a yes-or-no flag.
    attr_reader value: String?

    # The one-line description, or `nil`.
    attr_reader help: String?

    # The longer description, or `nil`.
    attr_reader help_long: String?

    # The values the flag offers, and whether it takes others.
    attr_reader choices: Choices

    # The switches that must come with this flag, such as `["--download"]`.
    attr_reader requires: Array[String]

    # Whether the flag may repeat, each time adding a value.
    attr_reader repeatable: bool

    # Whether the flag works on every command under the one that has it.
    attr_reader global: bool

    def self.new: (name: String, short: Array[String], long: Array[String], value: String?, help: String?, help_long: String?, choices: Choices, requires: Array[String], repeatable: bool, global: bool) -> instance
                | (String name, Array[String] short, Array[String] long, String? value, String? help, String? help_long, Choices choices, Array[String] requires, bool repeatable, bool global) -> instance

    # Builds a flag from its parts.
    #
    # - `name`: String, the flag's name in the spec.
    # - `short`: Array of String, the one-letter names.
    # - `long`: Array of String, the long names.
    # - `value`: String or `nil`, the name of the value.
    # - `help`: String or `nil`, the one-line description.
    # - `help_long`: String or `nil`, the longer description.
    # - `choices`: `Usage::Choices`, the values it offers.
    # - `requires`: Array of String, the switches that must come with it.
    # - `repeatable`: bool, whether it repeats.
    # - `global`: bool, whether it works on every command under its own.
    def initialize: (name: String, short: Array[String], long: Array[String], value: String?, help: String?, help_long: String?, choices: Choices, requires: Array[String], repeatable: bool, global: bool) -> void

    # Whether the flag may repeat, each time adding a value.
    #
    # ```ruby
    # due.repeatable? # => false
    # ```
    def repeatable?: () -> bool

    # Whether the flag works on every command under the one that has it.
    #
    # ```ruby
    # due.global? # => false
    # ```
    def global?: () -> bool

    # Whether the flag takes a value, as `--due friday` does.
    #
    # ```ruby
    # due.takes_value? # => true
    # ```
    def takes_value?: () -> bool

    # Whether the flag takes `word` as its value: one of its choices when they are strict, and any word when they
    # aren't or when it has none.
    #
    # - `word`: String, the value as typed.
    #
    # ```ruby
    # [sort.accepts?("due"), sort.accepts?("size")] # => [true, false]
    # [tag.accepts?("home"), tag.accepts?("garden")] # => [true, true]
    # due.accepts?("friday") # => true
    # ```
    def accepts?: (String word) -> bool

    # Every way to type the flag: the short names with one hyphen, then the long names with two.
    #
    # ```ruby
    # tag.switches # => ["--tag"]
    # ```
    def switches: () -> Array[String]
  end
end
