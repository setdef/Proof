module Usage
  # The letters written together in one word, such as `-qfd`.
  class Bundle
    @switches: Array[Switch]
    @stray: (^() -> bot)?

    # Takes the switches of the letters that name a flag, in the order typed, and what refuses the word when the next
    # letter, which names none, is reached, if there is one.
    def initialize: (Array[Switch] switches, (^() -> bot)? stray) -> void

    # Reads the letters in order, up to help, then the one that names no flag, then asks `line` for the next word for the
    # letters that take a value.
    def read: (Line line) -> void
  end
end
