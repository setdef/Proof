module Usage
  # One example command line, with the heading and the explanation the spec gives it.
  #
  # Help that opens with examples teaches a command faster than a list of flags. The examples belong to the spec, so
  # the help and the reference usage generates show the same ones.
  #
  # This class holds one example's command line and its text.
  #
  # Use it to print a command's examples in its help.
  #
  # ## Examples
  #
  # ```ruby
  # require "usage"
  # spec = Usage::Spec.read(%q({"examples": [{"code": "todo add 'Buy milk'", "header": "Add an item"}]}))
  # example = spec.examples.first || raise
  # example.code # => "todo add 'Buy milk'"
  # example.help # => nil
  # ```
  class Example < Data
    # The command line to show.
    attr_reader code: String

    # The heading, or `nil`.
    attr_reader header: String?

    # The explanation, or `nil`.
    attr_reader help: String?

    def self.new: (code: String, header: String?, help: String?) -> instance
                | (String code, String? header, String? help) -> instance

    # Builds an example from its parts.
    #
    # - `code`: String, the command line.
    # - `header`: String or `nil`, the heading.
    # - `help`: String or `nil`, the explanation.
    def initialize: (code: String, header: String?, help: String?) -> void
  end
end
