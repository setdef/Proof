module Usage
  # The tables of one command's help: its subcommands, its arguments, its flags, and the global flags it takes.
  class Tables
    @command: Command
    @global_flags: Array[Flag]

    # Takes the command and the global flags it takes from itself and the commands above it.
    def initialize: (Command command, Array[Flag] global_flags) -> void

    # Each table, or `nil` for one with no rows. The program's subcommands are titled as its commands.
    def all: () -> Array[String?]

    private

    def commands: () -> String?
  end
end
