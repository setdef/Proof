# The parts of the `sqlite3` gem that Proof calls, which ships no signatures.
# Steep checks Proof's calls against these, so a call the gem doesn't answer is
# an error here and not in a run.
module SQLite3
  # What SQLite raises when the file is locked and the busy handler gave up, or
  # was never asked.
  class BusyException < StandardError
  end

  class Database
    # Makes SQLite wait up to `milliseconds` for a locked file, sleeping in
    # Ruby between tries, and give up with a busy error after that.
    def busy_handler_timeout=: (Integer milliseconds) -> Integer

    # The journal mode now, such as `"wal"`.
    def journal_mode: () -> String

    # Sets the journal mode, such as `"wal"`.
    def journal_mode=: (String mode) -> String
  end
end
