# The reader of the project file gives the domain whatever the file holds, a
# number where text belongs and `#null` where a number does, and the domain
# refuses what it can't use. These overloads say so for the lib target. The
# domain gem is checked alone, with the signatures it declares.
module Proof
  class Label
    def self.new: (name: top) -> instance
                | ...
  end

  class OS
    def self.new: (name: top) -> instance
                | ...
  end

  class PathPattern
    def self.new: (path: top) -> instance
                | ...
  end

  class Resources
    def self.request: (cpus: top, memory: top) -> Resources
                    | ...
  end

  class TaskSettings
    def self.new: (**top) -> instance
                | ...
  end

  class TaskEntry
    def self.new: (name: top, ?command: top, ?settings: TaskSettings) -> instance
                | ...
  end
end
