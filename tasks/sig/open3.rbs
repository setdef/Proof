# Steep's Open3 signature lacks the +chdir:+ option that Open3 passes on to
# Process.spawn, and the environment that comes before the command.
module Open3
  def self.capture2: (*String command, ?chdir: String) -> [String, Process::Status]
                   | ...

  def self.capture2e: (*String command, ?chdir: String) -> [String, Process::Status]
                    | (Hash[String, String?] environment, *String command, ?chdir: String) -> [String, Process::Status]
                    | ...
end
