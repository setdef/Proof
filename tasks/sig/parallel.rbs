# The part of the parallel gem that the tasks use.
module Parallel
  def self.processor_count: () -> Integer

  def self.map: [T, U] (Array[T] items, in_threads: Integer) { (T) -> U } -> Array[U]
end

# The part of the parallel_tests gem that the tasks use.
module ParallelTests
  def self.determine_number_of_processes: (Integer? count) -> Integer
end
